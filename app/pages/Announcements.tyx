page Announcements

title "Announcements"

needs
  Auth

meta
  transition "fade"

state
  checkedAuth: false
  forbidden: false
  loading: true
  listError: ""
  products: []
  entries: []
  phaseTabs: []
  kinds: ["info", "maintenance", "incident"]
  statuses: ["draft", "published"]
  filterProduct: 0
  filterPhase: "all"
  chipOn: "chip chip-on"
  chipOff: "chip chip-off"
  editorOpen: false
  editingId: 0
  fProduct: 0
  fKind: "info"
  fStatus: "draft"
  fTitle: ""
  fBody: ""
  fStarts: ""
  fEnds: ""
  errors: {}
  formError: ""
  saving: false

computed
  visible() {
    return this.entries.filter((e) => (this.filterProduct is 0 or e.product_id is this.filterProduct or e.product_id is 0) and (this.filterPhase is "all" or e.phase is this.filterPhase))
  }

action
  setField(field, value) {
    this[field] = value
  }

  setFilter(field, value) {
    this[field] = value
  }

  errorsOf(raw) {
    return Object.fromEntries(Object.keys(raw).map((k) => [k, raw[k][0]]))
  }

  phaseText(p) {
    if p is "active" {
      return "Active"
    }
    if p is "upcoming" {
      return "Upcoming"
    }
    if p is "ended" {
      return "Ended"
    }
    return "Draft"
  }

  phaseBadge(p) {
    if p is "active" {
      return "badge-green"
    }
    if p is "upcoming" {
      return "badge-amber"
    }
    return "badge-gray"
  }

  kindBadge(kind) {
    if kind is "incident" {
      return "badge-red"
    }
    if kind is "maintenance" {
      return "badge-amber"
    }
    return "badge-blue"
  }

  whenText(value) {
    if not value {
      return ""
    }
    const d = new Date(value)
    const day = d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
    const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
    return day + ", " + time
  }

  rangeText(e) {
    const startText = this.whenText(e.starts_at)
    const endText = this.whenText(e.ends_at)
    if startText and endText {
      return startText + " to " + endText
    }
    if startText {
      return "From " + startText + ", no end set"
    }
    return "Not started"
  }

  // The value a datetime-local input expects, in the browser's own timezone.
  toLocalInput(iso) {
    if not iso {
      return ""
    }
    const d = new Date(iso)
    const pad = (n) => (n < 10 ? "0" + n : "" + n)
    return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes())
  }

  decorate(e, prods) {
    const owner = prods.find((p) => p.id is e.product_id)
    return Object.assign({}, e, {
      productName: e.product_id is 0 ? "All products" : (owner ? owner.name : "Unknown product"),
      phaseLabel: this.phaseText(e.phase),
      phaseClass: this.phaseBadge(e.phase),
      kindClass: this.kindBadge(e.kind),
      rangeLabel: this.rangeText(e),
      preview: String(e.body).replace(/\n/g, " ").slice(0, 140)
    })
  }

  resetForm() {
    this.fProduct = this.filterProduct is 0 ? (this.products.length > 0 ? this.products[0].id : 0) : this.filterProduct
    this.fKind = "info"
    this.fStatus = "draft"
    this.fTitle = ""
    this.fBody = ""
    this.fStarts = ""
    this.fEnds = ""
    this.errors = {}
    this.formError = ""
  }

  openNew() {
    this.resetForm()
    this.editingId = 0
    this.editorOpen = true
  }

  openEdit(e) {
    this.resetForm()
    this.editingId = e.id
    this.fProduct = e.product_id
    this.fKind = e.kind
    this.fStatus = e.status
    this.fTitle = e.title
    this.fBody = e.body
    this.fStarts = this.toLocalInput(e.starts_at)
    this.fEnds = this.toLocalInput(e.ends_at)
    this.editorOpen = true
  }

  closeEditor() {
    this.editorOpen = false
    this.editingId = 0
    this.resetForm()
  }

  async load() {
    const results = await Promise.all([
      useApi("/api/admin/products"),
      useApi("/api/admin/announcements")
    ])
    const productRes = results[0]
    const entryRes = results[1]

    if productRes.status is 403 or entryRes.status is 403 {
      this.forbidden = true
      return null
    }
    if not productRes.ok or not entryRes.ok {
      this.listError = "Couldn't load the announcements."
      return null
    }

    this.products = productRes.data
    this.entries = entryRes.data.map((e) => this.decorate(e, productRes.data))
    this.listError = ""
  }

  async save() {
    if this.saving {
      return null
    }

    this.saving = true
    this.errors = {}
    this.formError = ""

    const isNew = this.editingId is 0
    const body = {
      product_id: this.fProduct,
      kind: this.fKind,
      title: this.fTitle,
      body: this.fBody,
      status: this.fStatus,
      starts_at: this.fStarts ? new Date(this.fStarts).toISOString() : "",
      ends_at: this.fEnds ? new Date(this.fEnds).toISOString() : ""
    }
    const path = isNew ? "/api/admin/announcements" : "/api/admin/announcements/" + this.editingId
    const result = await useApi(path, { method: isNew ? "POST" : "PUT", body: body })

    this.saving = false

    if result.ok {
      this.closeEditor()
      await this.load()
      return null
    }

    const raw = result.data?.errors
    if raw {
      this.errors = this.errorsOf(raw)
    } else {
      this.formError = result.data?.error ?? result.error ?? "Could not save the announcement."
    }
  }

  async resolve(e) {
    if not confirm("End \"" + e.title + "\" now?") {
      return null
    }

    this.listError = ""
    const result = await useApi("/api/admin/announcements/" + e.id + "/resolve", { method: "POST", body: {} })

    if result.ok {
      await this.load()
    } else {
      this.listError = result.data?.error ?? result.error ?? "Could not end the announcement."
    }
  }

  async remove(e) {
    if not confirm("Delete \"" + e.title + "\"?") {
      return null
    }

    this.listError = ""
    const result = await useApi("/api/admin/announcements/" + e.id, { method: "DELETE" })

    if result.ok {
      if this.editingId is e.id {
        this.closeEditor()
      }
      await this.load()
    } else {
      this.listError = result.data?.error ?? result.error ?? "Could not delete the announcement."
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    this.phaseTabs = [
      { key: "all", label: "All" },
      { key: "active", label: "Active" },
      { key: "upcoming", label: "Upcoming" },
      { key: "draft", label: "Drafts" },
      { key: "ended", label: "Ended" }
    ]

    await this.load()
    this.loading = false
    this.checkedAuth = true

    if window.location.search.includes("new=1") and this.can("announcements.manage") {
      this.openNew()
    }
  }

template
{{#if checkedAuth}}
  <div class="page">

{{#if forbidden}}
    <div class="alert alert-warning max-w-2xl">
      <h1 class="alert-title">You don't have access to the Hub</h1>
      <p>Your account doesn't have a role that opens this page, or its email isn't verified yet. Ask a Hub admin for access.</p>
    </div>
{{/if}}

{{#if not forbidden}}
    <div class="page-header">
      <div>
        <h1 class="page-title">Announcements</h1>
        <p class="page-desc">Tell every connected site what is happening right now.</p>
      </div>
{{#if can("announcements.manage")}}
      <button onclick="{{ openNew() }}" class="btn btn-primary">New announcement</button>
{{/if}}
    </div>

{{#if listError}}
    <p role="alert" class="alert alert-error mb-6">{{ listError }}</p>
{{/if}}

{{#if editorOpen}}
    <section class="card p-5 sm:p-6 mb-8">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm font-semibold">{{ editingId is 0 ? 'New announcement' : 'Edit announcement' }}</h2>
        <button onclick="{{ closeEditor() }}" class="text-sm text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors">Close</button>
      </div>

{{#if formError}}
      <p role="alert" class="alert alert-error mb-4">{{ formError }}</p>
{{/if}}

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="a-product" class="label">Product</label>
          <select id="a-product" onchange="{{ setField('fProduct', Number(event.target.value)) }}" class="input">
            <option value="0" selected="{{ fProduct is 0 }}">All products</option>
{{#each p in products}}
            <option value="{{ p.id }}" selected="{{ fProduct is p.id }}">{{ p.name }}</option>
{{/each}}
          </select>
{{#if errors.product_id}}
          <p class="field-error">{{ errors.product_id }}</p>
{{/if}}
        </div>

        <div>
          <label for="a-kind" class="label">Kind</label>
          <select id="a-kind" onchange="{{ setField('fKind', event.target.value) }}" class="input capitalize">
{{#each k in kinds}}
            <option value="{{ k }}" selected="{{ fKind is k }}">{{ k }}</option>
{{/each}}
          </select>
{{#if errors.kind}}
          <p class="field-error">{{ errors.kind }}</p>
{{/if}}
        </div>

        <div>
          <label for="a-status" class="label">Status</label>
          <select id="a-status" onchange="{{ setField('fStatus', event.target.value) }}" class="input capitalize">
{{#each s in statuses}}
            <option value="{{ s }}" selected="{{ fStatus is s }}">{{ s }}</option>
{{/each}}
          </select>
{{#if errors.status}}
          <p class="field-error">{{ errors.status }}</p>
{{/if}}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div>
          <label for="a-starts" class="label">Starts at</label>
          <input id="a-starts" type="datetime-local" value="{{ fStarts }}" oninput="{{ setField('fStarts', event.target.value) }}" class="input" />
          <p class="hint">Leave empty to start as soon as it is published.</p>
{{#if errors.starts_at}}
          <p class="field-error">{{ errors.starts_at }}</p>
{{/if}}
        </div>

        <div>
          <label for="a-ends" class="label">Ends at</label>
          <input id="a-ends" type="datetime-local" value="{{ fEnds }}" oninput="{{ setField('fEnds', event.target.value) }}" class="input" />
          <p class="hint">Leave empty for no end. Use Resolve in the list when it is over.</p>
{{#if errors.ends_at}}
          <p class="field-error">{{ errors.ends_at }}</p>
{{/if}}
        </div>
      </div>

      <label for="a-title" class="label mt-4">Title</label>
      <input id="a-title" type="text" placeholder="Server provisioning is slower than usual" value="{{ fTitle }}" oninput="{{ setField('fTitle', event.target.value) }}" class="input" />
{{#if errors.title}}
      <p class="field-error">{{ errors.title }}</p>
{{/if}}

      <label for="a-body" class="label mt-4">What is happening (Markdown)</label>
      <textarea id="a-body" rows="6" value="{{ fBody }}" oninput="{{ setField('fBody', event.target.value) }}" class="input font-mono"></textarea>
{{#if errors.body}}
      <p class="field-error">{{ errors.body }}</p>
{{/if}}

      <div class="flex items-center gap-2 mt-5">
        <button onclick="{{ save() }}" disabled="{{ saving }}" class="btn btn-primary">
          {{ saving ? 'Saving…' : 'Save announcement' }}
        </button>
        <button onclick="{{ closeEditor() }}" class="btn btn-ghost">Cancel</button>
      </div>
    </section>
{{/if}}

    <div class="card flex flex-col gap-3 px-4 py-3 mb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="filter-label w-16">Product</span>
        <button onclick="{{ setFilter('filterProduct', 0) }}" class="{{ filterProduct is 0 ? chipOn : chipOff }}">All products</button>
{{#each p in products}}
        <button onclick="{{ setFilter('filterProduct', p.id) }}" class="{{ filterProduct is p.id ? chipOn : chipOff }}">{{ p.name }}</button>
{{/each}}
      </div>
      <div class="flex flex-wrap items-center gap-2 border-t border-zinc-100 dark:border-zinc-800 pt-3">
        <span class="filter-label w-16">Phase</span>
{{#each t in phaseTabs}}
        <button onclick="{{ setFilter('filterPhase', t.key) }}" class="{{ filterPhase is t.key ? chipOn : chipOff }}">{{ t.label }}</button>
{{/each}}
      </div>
    </div>

    <section class="card overflow-hidden">
{{#if loading}}
      <p class="px-5 py-10 text-center text-sm text-zinc-500">Loading…</p>
{{/if}}

{{#if not loading}}
{{#if visible.length is 0}}
      <div class="empty">
        <h3 class="empty-title">Nothing here</h3>
        <p class="empty-text">No announcements match these filters.</p>
      </div>
{{/if}}
{{/if}}

{{#each e in visible}}
      <div class="flex items-start gap-4 px-5 py-4 row-divider row-hover">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1">
            <span class="text-[13px] text-zinc-500 dark:text-zinc-400">{{ e.productName }}</span>
            <span class="badge {{ e.kindClass }}">{{ e.kind }}</span>
            <span class="badge {{ e.phaseClass }}">{{ e.phaseLabel }}</span>
          </div>
          <p class="text-[15px] font-medium text-zinc-900 dark:text-zinc-100">{{ e.title }}</p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 truncate">{{ e.preview }}</p>
          <p class="meta mt-2">{{ e.rangeLabel }}</p>
        </div>
{{#if can("announcements.manage")}}
        <div class="flex items-center gap-1 shrink-0">
{{#if e.phase is "active"}}
          <button onclick="{{ resolve(e) }}" class="btn btn-success-ghost btn-sm">Resolve</button>
{{/if}}
          <button onclick="{{ openEdit(e) }}" class="btn btn-ghost btn-sm">Edit</button>
          <button onclick="{{ remove(e) }}" class="btn btn-danger-ghost btn-sm">Delete</button>
        </div>
{{/if}}
      </div>
{{/each}}
    </section>
{{/if}}

  </div>
{{/if}}

{{#if not checkedAuth}}
  <p class="page-loading">Loading…</p>
{{/if}}