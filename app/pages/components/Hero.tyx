component Hero

props
  loggedIn: boolean

template
  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-12">
      <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-3 py-1 text-xs font-medium text-slate-600 dark:text-slate-400 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Tylix Hub
      </p>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight max-w-2xl">Release notes and uptime for every Tylix product</h1>
      <p class="text-slate-500 mt-3 max-w-xl leading-relaxed">Write a changelog entry once and publish it to every connected site. Watch each product's heartbeat from one page.</p>

      <div class="flex flex-wrap items-center gap-2 mt-8">
{{#if loggedIn}}
        <a href="/changelog?new=1" class="text-sm font-medium bg-indigo-600 text-white rounded-md px-3.5 py-2 hover:bg-indigo-500 transition-colors">New release</a>
        <a href="/status" class="text-sm border border-slate-300 dark:border-slate-700 rounded-md px-3.5 py-2 hover:bg-white dark:hover:bg-slate-800 transition-colors">View status</a>
{{/if}}
{{#if not loggedIn}}
        <a href="/login" class="text-sm font-medium bg-indigo-600 text-white rounded-md px-3.5 py-2 hover:bg-indigo-500 transition-colors">Sign in</a>
        <a href="#how-it-works" class="text-sm border border-slate-300 dark:border-slate-700 rounded-md px-3.5 py-2 hover:bg-white dark:hover:bg-slate-800 transition-colors">How it works</a>
{{/if}}
      </div>
    </div>
  </section>