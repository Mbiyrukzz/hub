component Hero

import { IconArrowRight } from "tylix-icons"

props
  loggedIn: boolean

template
  <section class="bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 pt-20 pb-16 sm:pt-24 sm:pb-20">
      <p class="inline-flex items-center gap-2 rounded-md border border-zinc-200 dark:border-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 mb-6">
        <span class="dot bg-emerald-500"></span>
        Internal console for Ashmif products
      </p>

      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1] max-w-3xl text-zinc-900 dark:text-white">Release notes and uptime for every product, in one place.</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 mt-5 max-w-2xl leading-relaxed">Write a changelog entry once and publish it to every connected site. Watch each product's heartbeat, uptime and incidents from a single console.</p>

      <div class="flex flex-wrap items-center gap-3 mt-10">
{{#if loggedIn}}
        <a href="/dashboard" class="btn btn-primary btn-lg">Open the console <IconArrowRight /></a>
        <a href="/status" class="btn btn-secondary btn-lg">View status</a>
{{/if}}
{{#if not loggedIn}}
        <a href="/login" class="btn btn-primary btn-lg">Sign in <IconArrowRight /></a>
        <a href="#how-it-works" class="btn btn-secondary btn-lg">How it works</a>
{{/if}}
      </div>
    </div>
  </section>
