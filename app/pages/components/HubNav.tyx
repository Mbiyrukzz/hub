component HubNav

import { IconBolt, IconSun, IconMoon } from "tylix-icons"

uses
  Auth
  Theme

computed
  tabs() {
    return [
      { label: "Overview", href: "/dashboard" },
      { label: "Products", href: "/products" },
      { label: "Changelog", href: "/changelog" }
    ]
  }

action
  isActive(href) {
    const path = window.location.pathname
    return path is href or path.startsWith(href + "/")
  }

  tabClass(href) {
    const base = "px-3 py-1.5 rounded-md text-sm transition-colors "
    if this.isActive(href) {
      return base + "font-medium bg-white/10 text-white"
    }
    return base + "text-slate-400 hover:text-white hover:bg-white/5"
  }

template
{{#if Auth.user}}
<header class="bg-slate-950 text-slate-100 border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center gap-6">

    <a href="/dashboard" class="flex items-center gap-2.5 shrink-0">
      <span class="w-7 h-7 rounded-md bg-indigo-500 flex items-center justify-center">
        <IconBolt class="w-4 h-4 text-white" />
      </span>
      <span class="font-semibold tracking-tight">Ashmif Hub</span>
    </a>

    <nav class="flex items-center gap-1 overflow-x-auto">
{{#each t in tabs}}
      <a href="{{ t.href }}" class="{{ tabClass(t.href) }}">{{ t.label }}</a>
{{/each}}
      <span class="px-3 py-1.5 text-sm text-slate-600 cursor-default flex items-center gap-2">
        Status
        <span class="rounded bg-white/5 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Soon</span>
      </span>
    </nav>

    <div class="ml-auto flex items-center gap-2 shrink-0">
      <button
        onclick="{{ Theme.toggle() }}"
        aria-label="Toggle color theme"
        class="w-8 h-8 flex items-center justify-center rounded-md text-slate-400 hover:text-white hover:bg-white/5 transition-colors"
      >
{{#if Theme.mode is "dark"}}
        <IconSun class="w-[18px] h-[18px]" />
{{#else}}
        <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
      </button>
      <span class="hidden sm:inline text-sm text-slate-400 ml-1">{{ Auth.user.name }}</span>
      <button onclick="{{ Auth.logout() }}" class="text-sm text-slate-300 border border-white/15 rounded-md px-3 py-1.5 hover:bg-white/5 transition-colors">Sign out</button>
    </div>

  </div>
</header>
{{/if}}