component PwaPrompt

// New version, offline and install prompts, bottom right, on every page.
// No 'ready to work offline' toast: Hub pages always need the network
// (they are never cached, see pwa in tylix.config).

uses
  Pwa

state
  hideInstall: false

action
  dismissInstall() {
    this.hideInstall = true
    try {
      localStorage.setItem("tylix:pwa-install-dismissed", "1")
    } catch (err) {
      return null
    }
  }

  async install() {
    await Pwa.install()
  }

onMount
  {
    try {
      this.hideInstall = localStorage.getItem("tylix:pwa-install-dismissed") is "1"
    } catch (err) {
      this.hideInstall = false
    }
  }

template
<div class="fixed right-4 bottom-4 z-[60] flex flex-col items-end gap-2 max-w-[calc(100vw-2rem)]" aria-live="polite">
{{#if not Pwa.online}}
  <div role="status" class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-1.5 text-sm font-medium shadow">
    <span class="w-2 h-2 rounded-full bg-red-500"></span> You're offline. Status may be out of date.
  </div>
{{/if}}
{{#if Pwa.updateAvailable}}
  <div role="status" class="w-96 max-w-full flex flex-wrap items-center justify-between gap-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-4 shadow-xl">
    <div class="flex-1 min-w-[12rem]">
      <p class="text-sm font-semibold">A new version of the Hub is ready</p>
      <p class="text-[13px] text-zinc-500">Reload to get the latest.</p>
    </div>
    <div class="flex gap-1.5 ml-auto">
      <button onclick="{{ Pwa.dismissUpdate() }}" class="btn btn-ghost btn-sm">Later</button>
      <button onclick="{{ Pwa.update() }}" class="btn btn-primary btn-sm">Reload</button>
    </div>
  </div>
{{#else if Pwa.installable and not hideInstall}}
  <div role="status" class="w-96 max-w-full flex flex-wrap items-center justify-between gap-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-4 shadow-xl">
    <div class="flex-1 min-w-[12rem]">
      <p class="text-sm font-semibold">Install Ashmif Hub</p>
      <p class="text-[13px] text-zinc-500">Open status and incidents from your home screen, like any other app.</p>
    </div>
    <div class="flex gap-1.5 ml-auto">
      <button onclick="{{ dismissInstall() }}" class="btn btn-ghost btn-sm">Not now</button>
      <button onclick="{{ install() }}" class="btn btn-primary btn-sm">Install</button>
    </div>
  </div>
{{/if}}
</div>
