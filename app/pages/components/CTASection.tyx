component CTASection

props
  loggedIn: boolean

template
  <section class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-14 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
{{#if loggedIn}}
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Ready to publish a release?</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 max-w-md">Write it once and it goes out to every connected site.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a href="/products?new=1" class="btn btn-secondary">Add a product</a>
        <a href="/changelog?new=1" class="btn btn-primary">New release</a>
      </div>
{{/if}}
{{#if not loggedIn}}
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Sign in to the Hub</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 max-w-md">Access is by role: ask a Hub admin to give your verified account one.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a href="/login" class="btn btn-primary">Sign in</a>
      </div>
{{/if}}
    </div>
    <div class="border-t border-zinc-200 dark:border-zinc-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-6 flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-500">
        <p>© Ashmif · Hub</p>
        <p>Release notes, status and incidents for every Ashmif product.</p>
      </div>
    </div>
  </section>
