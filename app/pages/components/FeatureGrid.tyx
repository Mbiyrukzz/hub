component FeatureGrid

import { IconClipboardList, IconActivity, IconPackage, IconKey } from "tylix-icons"

template
  <section class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-16">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-tight">Everything in one place</h2>
        <p class="text-zinc-600 dark:text-zinc-400 mt-2">Releases, uptime and product keys for every site you run.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px mt-10 rounded-lg overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-200 dark:bg-zinc-800">
        <div class="bg-white dark:bg-zinc-900 p-6">
          <div class="empty-icon"><IconClipboardList /></div>
          <h3 class="text-sm font-semibold mb-1.5">Write once, publish everywhere</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Draft, schedule or publish a release in Markdown. Every product that reads from the Hub shows it.</p>
        </div>
        <div class="bg-white dark:bg-zinc-900 p-6">
          <div class="empty-icon"><IconActivity /></div>
          <h3 class="text-sm font-semibold mb-1.5">A heartbeat every minute</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Products report in once a minute. No heartbeat for 3 minutes counts as down, and deploys and outages appear as events.</p>
        </div>
        <div class="bg-white dark:bg-zinc-900 p-6">
          <div class="empty-icon"><IconPackage /></div>
          <h3 class="text-sm font-semibold mb-1.5">One entry per site</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Each site that reads from the Hub is a product with its own slug, public API address and a reporting key.</p>
        </div>
        <div class="bg-white dark:bg-zinc-900 p-6">
          <div class="empty-icon"><IconKey /></div>
          <h3 class="text-sm font-semibold mb-1.5">Role-based access</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Viewers, editors, on-call and admins each see what their role allows. Verified emails only.</p>
        </div>
      </div>
    </div>
  </section>
