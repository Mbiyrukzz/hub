component FeatureGrid

state
  features: [
    { tag: "Changelog", badge: "bg-indigo-500/10 text-indigo-700 dark:text-indigo-300", title: "Write once, publish everywhere", body: "Draft, schedule or publish a release in Markdown. Every product that reads from the Hub shows it." },
    { tag: "Status", badge: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300", title: "A heartbeat every minute", body: "Products report in once a minute. No heartbeat for 3 minutes counts as down, and deploys and outages appear as events." },
    { tag: "Products", badge: "bg-sky-500/10 text-sky-700 dark:text-sky-300", title: "One entry per site", body: "Each site that reads from the Hub is a product with its own slug, public API address and a reporting key." },
    { tag: "Access", badge: "bg-amber-500/10 text-amber-700 dark:text-amber-300", title: "Admins only", body: "Only accounts listed in HUB_ADMINS with a verified email can open the Hub." }
  ]

template
  <section class="border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <h2 class="text-2xl font-semibold tracking-tight">Everything in one place</h2>
      <p class="text-sm text-slate-500 mt-1">Releases, uptime and product keys for every site you run.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
{{#each f in features}}
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-5">
          <span class="rounded px-1.5 py-0.5 text-[11px] font-medium {{ f.badge }}">{{ f.tag }}</span>
          <h3 class="text-sm font-semibold mt-3 mb-1">{{ f.title }}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{{ f.body }}</p>
        </div>
{{/each}}
      </div>
    </div>
  </section>