page MailInbox

import { IconArrowLeft, IconMail } from "tylix-icons"

state
  user: null
  checkedAuth: false
  logs: []
  logsLoading: true
  logsAvailable: true
  selectedLog: null

action
  selectLog(log) {
    this.selectedLog = log
  }

  closeDetail() {
    this.selectedLog = null
  }

onMount
  async {
    const me = await useApi("/api/me")

    if not me.ok {
      window.location.href = "/login"
      return null
    }

    this.user = me.data
    this.checkedAuth = true

    const result = await useApi("/api/_tylix/mail-logs")
    this.logsAvailable = result.ok
    if result.ok {
      this.logs = result.data.data
    }
    this.logsLoading = false
  }

template
{{#if checkedAuth}}
  <div class="page-narrow">
    <div>
      <a href="/dashboard" class="btn btn-ghost btn-sm -ml-3 mb-4">
        <IconArrowLeft class="w-4 h-4" /> Back to overview
      </a>

      <div class="page-header">
        <div>
          <h1 class="page-title">Mail</h1>
          <p class="page-desc">Emails sent or captured by your app.</p>
        </div>
      </div>

{{#if logsLoading}}
      <p class="page-loading">Loading…</p>
{{/if}}

{{#if not logsLoading}}
{{#if not logsAvailable}}
      <div class="card-dashed empty">
        <div class="empty-icon">
          <IconMail />
        </div>
        <h3 class="empty-title">Mail logs are only available while developing</h3>
        <p class="empty-text">
          Logged emails can contain password-reset links, so the production server does not expose them.
        </p>
      </div>
{{/if}}

{{#if logsAvailable}}
{{#if logs.length is 0}}
      <div class="card-dashed empty">
        <div class="empty-icon">
          <IconMail />
        </div>
        <h3 class="empty-title">No mail yet</h3>
        <p class="empty-text">
          Emails sent through Mail.send() will show up here.
        </p>
      </div>
{{/if}}

{{#if logs.length is not 0}}
      <div class="card overflow-hidden divide-y divide-zinc-100 dark:divide-zinc-800">
{{#each log in logs}}
        <button onclick="{{ selectLog(log) }}" class="w-full text-left px-5 py-3.5 row-hover flex items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm font-medium truncate">{{ log.subject }}</p>
            <p class="meta truncate mt-0.5">To: {{ log.recipient }}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
{{#if log.status is "sent"}}
            <span class="badge badge-green">sent</span>
{{/if}}
{{#if log.status is "captured"}}
            <span class="badge badge-gray">captured</span>
{{/if}}
{{#if log.status is "failed"}}
            <span class="badge badge-red">failed</span>
{{/if}}
          </div>
        </button>
{{/each}}
      </div>
{{/if}}
{{/if}}
{{/if}}

{{#if selectedLog}}
      <div class="modal-backdrop" onclick="{{ closeDetail() }}">
        <div class="modal p-6">
          <h3 class="font-semibold mb-1">{{ selectedLog.subject }}</h3>
          <p class="meta mb-4">To: {{ selectedLog.recipient }} · {{ selectedLog.driver }} · {{ selectedLog.status }}</p>
{{#if selectedLog.error}}
          <p class="alert alert-error mb-4">{{ selectedLog.error }}</p>
{{/if}}
          <div class="text-zinc-600 dark:text-zinc-400 text-xs whitespace-pre-wrap bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md p-4 font-mono">{{ selectedLog.body }}</div>
          <button onclick="{{ closeDetail() }}" class="btn btn-secondary mt-4">Close</button>
        </div>
      </div>
{{/if}}
    </div>
  </div>
{{/if}}