page Account

import { IconShield, IconCopy, IconCheck } from "tylix-icons"

title "Your account"

needs
  Auth

state
  checkedAuth: false
  loading: true
  loadError: ""
  enabled: false
  allowed: false
  confirmedAt: ""
  recoveryLeft: 0
  lowRecovery: false
  mode: ""
  password: ""
  code: ""
  qr: ""
  secret: ""
  recoveryCodes: []
  copied: false
  saving: false
  formError: ""
  notice: ""

computed
  qrSrc() {
    return this.qr ? "data:image/svg+xml;charset=utf-8," + encodeURIComponent(this.qr) : ""
  }

  secretGroups() {
    return this.secret.match(/.{1,4}/g)?.join(" ") ?? ""
  }

action
  setField(field, value) {
    this[field] = value
  }

  firstError(result, fallback) {
    const errors = result.data?.errors
    if errors {
      const key = Object.keys(errors)[0]
      return errors[key][0]
    }
    return result.data?.error ?? result.error ?? fallback
  }

  whenText(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
  }

  async load() {
    const result = await useApi("/api/account/two-factor")
    if result.ok {
      this.enabled = result.data.enabled
      this.allowed = result.data.allowed
      this.confirmedAt = result.data.confirmedAt ?? ""
      this.recoveryLeft = result.data.recoveryCodesLeft
      this.loadError = ""
    } else {
      this.loadError = this.firstError(result, "Couldn't load your two-factor settings.")
    }
    this.loading = false
  }

  open(mode) {
    this.mode = mode
    this.password = ""
    this.code = ""
    this.formError = ""
    this.notice = ""
    this.saving = false
    setTimeout(() => {
      const target = document.querySelector(".acct-form input")
      if target instanceof HTMLElement {
        target.focus()
      }
    }, 30)
  }

  cancel() {
    this.mode = ""
    this.qr = ""
    this.secret = ""
    this.formError = ""
    this.saving = false
  }

  // Step 1: the password again, then the server makes a key and a QR code.
  async startSetup() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/account/two-factor/setup", { method: "POST", body: { password: this.password } })
    this.saving = false
    if result.ok {
      this.qr = result.data.qr
      this.secret = result.data.secret
      this.password = ""
      this.mode = "scan"
      setTimeout(() => {
        const target = document.querySelector(".acct-form input")
        if target instanceof HTMLElement {
          target.focus()
        }
      }, 30)
    } else {
      this.formError = this.firstError(result, "Couldn't start the setup.")
    }
  }

  // Step 2: a code from the app proves it's set up right.
  async confirmSetup() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/account/two-factor/confirm", { method: "POST", body: { code: this.code } })
    this.saving = false
    if result.ok {
      this.recoveryCodes = result.data.recoveryCodes
      this.qr = ""
      this.secret = ""
      this.mode = "codes"
      await this.load()
    } else {
      this.formError = this.firstError(result, "That code didn't work.")
      this.code = ""
    }
  }

  async renewCodes() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/account/two-factor/recovery-codes", { method: "POST", body: { code: this.code } })
    this.saving = false
    if result.ok {
      this.recoveryCodes = result.data.recoveryCodes
      this.mode = "codes"
      this.lowRecovery = false
      await this.load()
    } else {
      this.formError = this.firstError(result, "That code didn't work.")
      this.code = ""
    }
  }

  async disable() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/account/two-factor/disable", { method: "POST", body: { password: this.password, code: this.code } })
    this.saving = false
    if result.ok {
      this.mode = ""
      this.notice = "Two-factor sign-in is off. Your password alone signs you in now."
      await this.load()
    } else {
      this.formError = this.firstError(result, "Couldn't turn it off.")
    }
  }

  async copyCodes() {
    try {
      await navigator.clipboard.writeText(this.recoveryCodes.join("\n"))
      this.copied = true
      setTimeout(() => {
        this.copied = false
      }, 2000)
    } catch (err) {
      this.formError = "Couldn't copy. Select the codes and copy them yourself."
    }
  }

  downloadCodes() {
    const text = "Ashmif Hub recovery codes for " + Auth.user.email + "\nEach code works once.\n\n" + this.recoveryCodes.join("\n") + "\n"
    const url = URL.createObjectURL(new Blob([text], { type: "text/plain" }))
    const a = document.createElement("a")
    a.href = url
    a.download = "ashmif-hub-recovery-codes.txt"
    a.click()
    setTimeout(() => URL.revokeObjectURL(url), 1000)
  }

  doneWithCodes() {
    this.recoveryCodes = []
    this.mode = ""
    this.notice = "Two-factor sign-in is on. You'll be asked for a code each time you sign in."
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }
    this.lowRecovery = new URLSearchParams(window.location.search).get("recovery") is "low"
    await this.load()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="page-narrow">
    <div class="page-header">
      <div>
        <h1 class="page-title">Account</h1>
        <p class="page-desc">{{ Auth.user.name }} · {{ Auth.user.email }}</p>
      </div>
    </div>

{{#if notice}}
    <div role="status" class="alert alert-success mb-6">{{ notice }}</div>
{{/if}}

{{#if lowRecovery}}
    <div role="alert" class="alert alert-warning mb-6">You're running low on recovery codes. Make a new set below and keep it somewhere safe.</div>
{{/if}}

    <section class="card p-6">
      <div class="flex items-start gap-4">
        <span class="empty-icon mb-0 shrink-0">
          <IconShield class="w-5 h-5" />
        </span>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <h2 class="font-semibold">Two-factor sign-in</h2>
{{#if enabled}}
            <span class="badge badge-green">On since {{ whenText(confirmedAt) }}</span>
{{#else}}
            <span class="badge badge-gray">Off</span>
{{/if}}
          </div>
          <p class="text-sm text-zinc-500">After your password, or Google or GitHub, the Hub asks for a 6-digit code from an authenticator app such as 1Password, Google Authenticator or Authy.</p>

{{#if loading}}
          <p class="text-sm text-zinc-500 mt-4">Loading…</p>
{{/if}}
{{#if loadError}}
          <p role="alert" class="text-sm text-red-600 dark:text-red-400 mt-4">{{ loadError }}</p>
{{/if}}

{{#if not loading and not loadError and mode is ""}}
          <div class="mt-5 flex flex-wrap gap-2">
{{#if enabled}}
            <span class="text-sm text-zinc-600 dark:text-zinc-400 self-center mr-2">{{ recoveryLeft }} recovery {{ recoveryLeft is 1 ? "code" : "codes" }} left</span>
            <button onclick="{{ open('renew') }}" class="btn btn-secondary btn-sm">New recovery codes</button>
            <button onclick="{{ open('disable') }}" class="btn btn-danger-outline btn-sm">Turn off</button>
{{#else}}
{{#if allowed}}
            <button onclick="{{ open('password') }}" class="btn btn-primary">Turn on two-factor sign-in</button>
{{#else}}
            <p class="text-sm text-zinc-500">Two-factor sign-in is offered to admins. Ask a Hub admin if you need it.</p>
{{/if}}
{{/if}}
          </div>
{{/if}}

{{#if mode is not ""}}
          <div class="acct-form mt-5 border-t border-zinc-200 dark:border-zinc-800 pt-5">

{{#if formError}}
            <p role="alert" class="text-sm text-red-600 dark:text-red-400 mb-3">{{ formError }}</p>
{{/if}}

{{#if mode is "password"}}
            <label for="a-password" class="label">Confirm your password to start</label>
            <input id="a-password" type="password" autocomplete="current-password" value="{{ password }}" oninput="{{ setField('password', event.target.value) }}" onkeydown="{{ event.key is 'Enter' and startSetup() }}" class="input sm:w-80" />
            <div class="flex gap-2 mt-4">
              <button onclick="{{ startSetup() }}" disabled="{{ saving }}" class="btn btn-primary">{{ saving ? "Checking…" : "Continue" }}</button>
              <button onclick="{{ cancel() }}" class="btn btn-ghost">Cancel</button>
            </div>
{{/if}}

{{#if mode is "scan"}}
            <ol class="text-sm text-zinc-600 dark:text-zinc-300 space-y-1 mb-4 list-decimal pl-5">
              <li>Scan this QR code with your authenticator app.</li>
              <li>Enter the 6-digit code it shows.</li>
            </ol>
            <div class="flex flex-col sm:flex-row gap-5 items-start">
              <img src="{{ qrSrc }}" alt="QR code for your authenticator app" width="176" height="176" class="w-44 h-44 rounded-md border border-zinc-200 dark:border-zinc-700 bg-white p-1" />
              <div class="min-w-0">
                <p class="text-xs text-zinc-500 mb-1">Can't scan? Type this key into the app:</p>
                <p class="font-mono text-sm break-all bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md px-2.5 py-1.5 mb-4 select-all">{{ secretGroups }}</p>
                <label for="a-code" class="label">Code from the app</label>
                <input id="a-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="123456" value="{{ code }}" oninput="{{ setField('code', event.target.value) }}" onkeydown="{{ event.key is 'Enter' and confirmSetup() }}" class="input w-40 text-base tracking-[0.25em] font-mono" />
                <div class="flex gap-2 mt-4">
                  <button onclick="{{ confirmSetup() }}" disabled="{{ saving }}" class="btn btn-primary">{{ saving ? "Checking…" : "Turn on" }}</button>
                  <button onclick="{{ cancel() }}" class="btn btn-ghost">Cancel</button>
                </div>
              </div>
            </div>
{{/if}}

{{#if mode is "codes"}}
            <h3 class="font-medium mb-1">Save your recovery codes</h3>
            <p class="text-sm text-zinc-500 mb-3">If you lose your phone, each of these signs you in once. They won't be shown again.</p>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-1 font-mono text-sm bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md p-4 mb-4 w-full sm:w-fit">
{{#each c in recoveryCodes}}
              <li>{{ c }}</li>
{{/each}}
            </ul>
            <div class="flex flex-wrap gap-2">
              <button onclick="{{ copyCodes() }}" class="btn btn-secondary btn-sm">
{{#if copied}}
                <IconCheck class="w-4 h-4" /> Copied
{{#else}}
                <IconCopy class="w-4 h-4" /> Copy
{{/if}}
              </button>
              <button onclick="{{ downloadCodes() }}" class="btn btn-secondary btn-sm">Download .txt</button>
              <button onclick="{{ doneWithCodes() }}" class="btn btn-primary btn-sm">I've saved them</button>
            </div>
{{/if}}

{{#if mode is "renew"}}
            <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-3">New codes replace the old ones, which stop working.</p>
            <label for="a-renew" class="label">Code from your authenticator app</label>
            <input id="a-renew" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="32" value="{{ code }}" oninput="{{ setField('code', event.target.value) }}" onkeydown="{{ event.key is 'Enter' and renewCodes() }}" class="input w-40 text-base tracking-[0.25em] font-mono" />
            <div class="flex gap-2 mt-4">
              <button onclick="{{ renewCodes() }}" disabled="{{ saving }}" class="btn btn-primary">{{ saving ? "Checking…" : "Make new codes" }}</button>
              <button onclick="{{ cancel() }}" class="btn btn-ghost">Cancel</button>
            </div>
{{/if}}

{{#if mode is "disable"}}
            <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-3">To turn it off, confirm your password and a current code (or a recovery code).</p>
            <div class="flex flex-col sm:flex-row gap-3">
              <div>
                <label for="a-dpass" class="label">Password</label>
                <input id="a-dpass" type="password" autocomplete="current-password" value="{{ password }}" oninput="{{ setField('password', event.target.value) }}" class="input sm:w-60" />
              </div>
              <div>
                <label for="a-dcode" class="label">Code</label>
                <input id="a-dcode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="32" value="{{ code }}" oninput="{{ setField('code', event.target.value) }}" onkeydown="{{ event.key is 'Enter' and disable() }}" class="input sm:w-40 font-mono" />
              </div>
            </div>
            <div class="flex gap-2 mt-4">
              <button onclick="{{ disable() }}" disabled="{{ saving }}" class="btn btn-danger">{{ saving ? "Checking…" : "Turn off two-factor" }}</button>
              <button onclick="{{ cancel() }}" class="btn btn-ghost">Cancel</button>
            </div>
{{/if}}

          </div>
{{/if}}
        </div>
      </div>
    </section>
  </div>
{{/if}}
