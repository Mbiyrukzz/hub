page Dashboard

import { IconPlus, IconClipboardList, IconActivity, IconChevronRight } from "tylix-icons"

title "Overview"

needs
  Auth

meta
  transition "fade"

state
  checkedAuth: false
  forbidden: false
  loadError: ""
  origin: ""
  copied: ""
  productCount: 0
  publishedCount: 0
  scheduledCount: 0
  draftCount: 0
  productCards: []
  recent: []

computed
  greeting() {
    const hour = new Date().getHours()
    if hour < 12 {
      return "Good morning"
    }
    if hour < 18 {
      return "Good afternoon"
    }
    return "Good evening"
  }

action
  stateOf(e) {
    if e.status is "draft" {
      return "draft"
    }
    const at = new Date(e.published_at).getTime()
    if e.status is "scheduled" and at > Date.now() {
      return "scheduled"
    }
    return "live"
  }

  stateLabel(s) {
    if s is "live" {
      return "Published"
    }
    if s is "scheduled" {
      return "Scheduled"
    }
    return "Draft"
  }

  dotClass(s) {
    if s is "live" {
      return "bg-emerald-500"
    }
    if s is "scheduled" {
      return "bg-amber-400"
    }
    return "bg-zinc-400"
  }

  categoryBadge(category) {
    const map = [
      ["added", "badge-violet"],
      ["improved", "badge-blue"],
      ["fixed", "badge-teal"],
      ["security", "badge-amber"],
      ["breaking", "badge-red"]
    ]
    const hit = map.find((m) => m[0] is category)
    return hit ? hit[1] : "badge-gray"
  }

  whenText(value) {
    if not value {
      return "Not published"
    }
    const d = new Date(value)
    const day = d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
    const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
    return day + ", " + time
  }

  decorateEntry(e, prods) {
    const owner = prods.find((p) => p.id is e.product_id)
    const s = this.stateOf(e)
    return Object.assign({}, e, {
      productName: owner ? owner.name : "Unknown product",
      state: s,
      stateText: this.stateLabel(s),
      dot: this.dotClass(s),
      badge: this.categoryBadge(e.category),
      whenLabel: this.whenText(e.published_at)
    })
  }

  decorateProduct(p, list) {
    const mine = list.filter((e) => e.product_id is p.id)
    const live = mine
      .filter((e) => this.stateOf(e) is "live")
      .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime())
    return Object.assign({}, p, {
      endpoint: "/api/v1/products/" + p.slug + "/changelog",
      entryCount: mine.length,
      latestText: live.length > 0 ? "v" + live[0].version : "No releases"
    })
  }

  clearCopied() {
    this.copied = ""
  }

  async copyEndpoint(slug) {
    const url = this.origin + "/api/v1/products/" + slug + "/changelog"
    try {
      await navigator.clipboard.writeText(url)
      this.copied = slug
      setTimeout(() => this.clearCopied(), 1500)
    } catch (err) {
      this.copied = ""
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    this.origin = window.location.origin

    const results = await Promise.all([
      useApi("/api/admin/products"),
      useApi("/api/admin/changelog")
    ])
    const productRes = results[0]
    const entryRes = results[1]

    if productRes.status is 403 or entryRes.status is 403 {
      this.forbidden = true
      this.checkedAuth = true
      return null
    }

    if not productRes.ok or not entryRes.ok {
      this.loadError = "Couldn't load the Hub data. Try again in a moment."
      this.checkedAuth = true
      return null
    }

    const prods = Array.isArray(productRes.data) ? productRes.data : []
    const list = Array.isArray(entryRes.data) ? entryRes.data : []

    this.productCount = prods.length
    this.publishedCount = list.filter((e) => this.stateOf(e) is "live").length
    this.scheduledCount = list.filter((e) => this.stateOf(e) is "scheduled").length
    this.draftCount = list.filter((e) => this.stateOf(e) is "draft").length
    this.productCards = prods.map((p) => this.decorateProduct(p, list))
    this.recent = list.slice(0, 6).map((e) => this.decorateEntry(e, prods))

    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="page">

{{#if forbidden}}
    <div class="alert alert-warning max-w-2xl">
      <h1 class="alert-title">You don't have access to the Hub</h1>
      <p>Your account doesn't have a role that opens this page, or its email isn't verified yet. Ask a Hub admin for access.</p>
    </div>
{{/if}}

{{#if not forbidden}}
    <div class="page-header">
      <div>
        <p class="page-eyebrow">{{ greeting }}, {{ Auth.user.name }}</p>
        <h1 class="page-title">Overview</h1>
        <p class="page-desc">Releases and products across every connected site.</p>
      </div>
      <div class="page-actions">
{{#if can("products.manage")}}
        <a href="/products?new=1" class="btn btn-secondary">Add product</a>
{{/if}}
{{#if can("changelog.manage")}}
        <a href="/changelog?new=1" class="btn btn-primary"><IconPlus /> New release</a>
{{/if}}
      </div>
    </div>

{{#if loadError}}
    <p role="alert" class="alert alert-error mb-6">{{ loadError }}</p>
{{/if}}

    <dl class="stat-grid mb-8">
      <div class="stat">
        <dt class="stat-label">Products</dt>
        <dd class="stat-value">{{ productCount }}</dd>
      </div>
      <div class="stat">
        <dt class="stat-label"><span class="dot bg-emerald-500"></span> Published</dt>
        <dd class="stat-value">{{ publishedCount }}</dd>
      </div>
      <div class="stat">
        <dt class="stat-label"><span class="dot bg-amber-400"></span> Scheduled</dt>
        <dd class="stat-value">{{ scheduledCount }}</dd>
      </div>
      <div class="stat">
        <dt class="stat-label"><span class="dot bg-zinc-400"></span> Drafts</dt>
        <dd class="stat-value">{{ draftCount }}</dd>
      </div>
    </dl>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-6 items-start">

      <section class="card min-w-0 overflow-hidden">
        <div class="card-header">
          <h2 class="card-title">Latest releases</h2>
          <a href="/changelog" class="text-sm link">View all</a>
        </div>

{{#if recent.length is 0}}
        <div class="empty">
          <div class="empty-icon"><IconClipboardList /></div>
          <h3 class="empty-title">No releases yet</h3>
          <p class="empty-text">Write your first changelog entry and it will be available to every connected site.</p>
{{#if can("changelog.manage")}}
          <a href="/changelog?new=1" class="btn btn-primary mt-5">New release</a>
{{/if}}
        </div>
{{/if}}

{{#each e in recent}}
        <div class="row-divider flex items-start gap-4 px-5 py-4">
          <span class="dot mt-1.5 {{ e.dot }}" title="{{ e.stateText }}"></span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-sm font-medium">{{ e.productName }}</span>
              <span class="mono-meta">v{{ e.version }}</span>
              <span class="badge {{ e.badge }}">{{ e.category }}</span>
            </div>
            <p class="text-sm text-zinc-700 dark:text-zinc-300 mt-1 truncate">{{ e.title }}</p>
          </div>
          <div class="hidden sm:block text-right shrink-0">
            <p class="text-xs font-medium text-zinc-700 dark:text-zinc-300">{{ e.stateText }}</p>
            <p class="meta mt-0.5">{{ e.whenLabel }}</p>
          </div>
        </div>
{{/each}}
      </section>

      <aside class="space-y-6 min-w-0">

        <section class="card overflow-hidden">
          <div class="card-header">
            <h2 class="card-title">Products</h2>
            <a href="/products" class="text-sm link">Manage</a>
          </div>

{{#if productCards.length is 0}}
          <p class="px-5 py-4 text-sm text-zinc-500">No products registered yet.</p>
{{/if}}

{{#each p in productCards}}
          <div class="row-divider px-5 py-3.5">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium truncate">{{ p.name }}</p>
              <span class="shrink-0 mono-meta">{{ p.latestText }}</span>
            </div>
            <button onclick="{{ copyEndpoint(p.slug) }}" title="Copy the public API address" class="code-chip mt-2 w-full text-left truncate hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">{{ copied is p.slug ? 'Copied to clipboard' : p.endpoint }}</button>
          </div>
{{/each}}
        </section>

        <a href="/status" class="card flex items-center gap-4 p-5 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
          <span class="empty-icon mb-0"><IconActivity /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold">System status</span>
            <span class="block text-sm text-zinc-500 mt-0.5">Heartbeats, uptime and recent events.</span>
          </span>
          <IconChevronRight class="w-4 h-4 text-zinc-400 shrink-0" />
        </a>

      </aside>
    </div>
{{/if}}

  </div>
{{/if}}

{{#if not checkedAuth}}
  <p class="page-loading">Loading…</p>
{{/if}}
