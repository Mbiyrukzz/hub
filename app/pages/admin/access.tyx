page AccessControl

import { IconPlus, IconX } from "tylix-icons"

title "Roles & permissions"

needs
  Auth

permissions
  roles.manage

state
  tab: "roles"
  roles: []
  permissionList: []
  users: []
  me: ""
  loading: true
  loadError: ""
  notice: ""
  query: ""
  modal: ""
  editing: ""
  roleName: ""
  roleDescription: ""
  rolePermissions: []
  roleInherits: []
  customGrant: ""
  permissionName: ""
  permissionDescription: ""
  userId: null
  userName: ""
  userRoles: []
  confirmKind: ""
  confirmName: ""
  saving: false
  formError: ""

computed
  permissionGroups() {
    const groups = this.permissionList.map(p => this.groupOf(p.name)).filter((g, i, all) => all.indexOf(g) is i).sort()
    return groups.map(g => ({ name: g, items: this.permissionList.filter(p => this.groupOf(p.name) is g) }))
  }

  customGrants() {
    const known = this.permissionList.map(p => p.name)
    return this.rolePermissions.filter(p => not known.includes(p))
  }

  inheritable() {
    return this.roles.filter(r => r.name is not this.editing and not r.superAdmin)
  }

  filteredUsers() {
    const q = this.query.trim().toLowerCase()
    if q is "" {
      return this.users
    }
    return this.users.filter(u => (u.name + " " + u.email).toLowerCase().includes(q))
  }

  everyoneRoles() {
    return this.roles.filter(r => r.everyone).map(r => r.name)
  }

action
  groupOf(name) {
    return name.includes(".") ? name.split(".")[0] : "general"
  }

  // Which roles grant a permission, wildcards included (posts.* covers
  // posts.edit). Inherited grants aren't listed here.
  covers(grant, name) {
    if grant.startsWith("!") {
      return false
    }
    if grant is "*" or grant is name {
      return true
    }
    if grant.endsWith(".*") {
      return name.startsWith(grant.slice(0, -1))
    }
    return grant.includes(",") and grant.split(".").length is name.split(".").length and grant.split(".").every((part, i) => part.split(",").map(x => x.trim()).includes(name.split(".")[i]))
  }

  grantedBy(name) {
    return this.roles.filter(r => not r.superAdmin and r.permissions.some(g => this.covers(g, name))).map(r => r.name).join(", ")
  }

  grantLabel(grant) {
    return grant.startsWith("!") ? "not " + grant.slice(1) : grant
  }

  async load() {
    const result = await useApi("/api/admin/access")
    if result.ok {
      this.roles = result.data.roles
      this.permissionList = result.data.permissions
      this.users = result.data.users
      this.me = result.data.me
      this.loadError = ""
    } else {
      this.loadError = result.error ?? "Couldn't load roles and permissions."
    }
    this.loading = false
  }

  flash(message) {
    this.notice = message
    setTimeout(() => {
      if this.notice is message {
        this.notice = ""
      }
    }, 3500)
  }

  close() {
    this.modal = ""
    this.formError = ""
    this.saving = false
  }

  // Moves focus into the modal that just opened, so typing and Escape work.
  focusModal() {
    setTimeout(() => {
      const target = document.querySelector(".acc-modal [autofocus]:not([disabled]), .acc-modal input:not([disabled])")
      if target instanceof HTMLElement {
        target.focus()
      }
    }, 30)
  }

  openNewRole() {
    this.editing = ""
    this.roleName = ""
    this.roleDescription = ""
    this.rolePermissions = []
    this.roleInherits = []
    this.customGrant = ""
    this.formError = ""
    this.modal = "role"
    this.focusModal()
  }

  openEditRole(role) {
    this.editing = role.name
    this.roleName = role.name
    this.roleDescription = role.description ?? ""
    this.rolePermissions = [...role.permissions]
    this.roleInherits = [...role.inherits]
    this.customGrant = ""
    this.formError = ""
    this.modal = "role"
    this.focusModal()
  }

  addCustomGrant() {
    const grant = this.customGrant.trim()
    if grant is "" {
      return null
    }
    if not this.rolePermissions.includes(grant) {
      this.rolePermissions = [...this.rolePermissions, grant]
    }
    this.customGrant = ""
  }

  removeGrant(grant) {
    this.rolePermissions = this.rolePermissions.filter(p => p is not grant)
  }

  toggleGroup(group) {
    const names = group.items.map(p => p.name)
    const all = names.every(n => this.rolePermissions.includes(n))
    const rest = this.rolePermissions.filter(p => not names.includes(p))
    this.rolePermissions = all ? rest : [...rest, ...names]
  }

  async saveRole() {
    if this.saving {
      return null
    }
    if this.roleName.trim() is "" {
      this.formError = "Give the role a name, like editor or support."
      return null
    }
    this.saving = true
    this.formError = ""
    const body = { name: this.roleName.trim(), description: this.roleDescription, permissions: this.rolePermissions, inherits: this.roleInherits }
    const result = this.editing
      ? await useApi("/api/admin/roles/" + encodeURIComponent(this.editing), { method: "PUT", body: body })
      : await useApi("/api/admin/roles", { method: "POST", body: body })
    if result.ok {
      const verb = this.editing ? "updated" : "created"
      this.close()
      this.flash("Role " + body.name + " " + verb + ".")
      await this.load()
    } else {
      this.formError = result.error ?? "Couldn't save that role."
      this.saving = false
    }
  }

  openNewPermission() {
    this.permissionName = ""
    this.permissionDescription = ""
    this.formError = ""
    this.modal = "permission"
    this.focusModal()
  }

  async savePermission() {
    if this.saving {
      return null
    }
    if this.permissionName.trim() is "" {
      this.formError = "Name the permission, like invoices.export."
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/admin/permissions", {
      method: "POST",
      body: { name: this.permissionName.trim(), description: this.permissionDescription }
    })
    if result.ok {
      this.close()
      this.flash("Permission " + result.data.name + " created. Give it to a role to use it.")
      await this.load()
    } else {
      this.formError = result.error ?? "Couldn't create that permission."
      this.saving = false
    }
  }

  openUser(user) {
    this.userId = user.id
    this.userName = user.name ?? user.email
    this.userRoles = [...user.roles]
    this.formError = ""
    this.modal = "user"
    this.focusModal()
  }

  async saveUserRoles() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const result = await useApi("/api/admin/users/" + this.userId + "/roles", { method: "PUT", body: { roles: this.userRoles } })
    if result.ok {
      this.close()
      this.flash("Roles for " + this.userName + " saved.")
      await this.load()
    } else {
      this.formError = result.error ?? "Couldn't save those roles."
      this.saving = false
    }
  }

  askDelete(kind, name) {
    this.confirmKind = kind
    this.confirmName = name
    this.formError = ""
    this.modal = "confirm"
    this.focusModal()
  }

  async confirmDelete() {
    if this.saving {
      return null
    }
    this.saving = true
    this.formError = ""
    const base = this.confirmKind is "role" ? "/api/admin/roles/" : "/api/admin/permissions/"
    const result = await useApi(base + encodeURIComponent(this.confirmName), { method: "DELETE" })
    if result.ok {
      const label = this.confirmKind is "role" ? "Role " : "Permission "
      this.close()
      this.flash(label + this.confirmName + " deleted.")
      await this.load()
    } else {
      this.formError = result.error ?? "Couldn't delete it."
      this.saving = false
    }
  }

onMount
  async {
    document.addEventListener("keydown", event => {
      if event.key is "Escape" and this.modal is not "" {
        this.close()
      }
    })
    await this.load()
  }

template
<div class="acc">
  <header class="acc-head">
    <div>
      <p class="tx-eyebrow">Access control</p>
      <h1 class="tx-title">Roles &amp; permissions</h1>
      <p class="tx-subtitle">Decide who can do what. Changes apply on the user’s next request.</p>
    </div>
    <div class="acc-actions">
      <button class="tx-btn tx-btn-outline tx-btn-sm" onclick="{{ openNewPermission() }}">New permission</button>
      <button class="tx-btn tx-btn-primary tx-btn-sm" onclick="{{ openNewRole() }}"><IconPlus class="acc-ico" /> New role</button>
    </div>
  </header>

{{#if notice}}
  <p class="tx-alert tx-alert-success acc-notice" role="status">{{ notice }}</p>
{{/if}}

  <div class="acc-tabs" role="tablist" aria-label="Sections">
    <button role="tab" aria-selected="{{ tab is 'roles' }}" class="acc-tab" class:is-active="{{ tab is 'roles' }}" onclick="{{ tab = 'roles' }}">Roles <span class="acc-count">{{ roles.length }}</span></button>
    <button role="tab" aria-selected="{{ tab is 'permissions' }}" class="acc-tab" class:is-active="{{ tab is 'permissions' }}" onclick="{{ tab = 'permissions' }}">Permissions <span class="acc-count">{{ permissionList.length }}</span></button>
    <button role="tab" aria-selected="{{ tab is 'users' }}" class="acc-tab" class:is-active="{{ tab is 'users' }}" onclick="{{ tab = 'users' }}">Users <span class="acc-count">{{ users.length }}</span></button>
  </div>

{{#if loading}}
  <div class="acc-grid" aria-busy="true">
    <div class="tx-panel acc-skeleton"></div>
    <div class="tx-panel acc-skeleton"></div>
    <div class="tx-panel acc-skeleton"></div>
  </div>
{{#else if loadError}}
  <p class="tx-alert tx-alert-error" role="alert">{{ loadError }}</p>
{{#else if tab is "roles"}}
  <div class="acc-grid">
{{#each r in roles}}
    <article class="tx-panel acc-card">
      <div class="acc-card-head">
        <h2 class="acc-role">{{ r.name }}</h2>
{{#if r.superAdmin}}
        <span class="tx-badge acc-badge-brand">every permission</span>
{{#else if r.everyone}}
        <span class="tx-badge">every user</span>
{{#else}}
        <span class="tx-badge">{{ r.users }} {{ r.users is 1 ? 'user' : 'users' }}</span>
{{/if}}
      </div>
      <p class="acc-desc">{{ r.description ?? 'No description.' }}</p>
{{#if r.inherits.length > 0}}
      <p class="acc-meta">Inherits {{ r.inherits.join(', ') }}</p>
{{/if}}
      <div class="acc-chips">
{{#each p in r.permissions}}
        <code class="acc-chip" class:is-deny="{{ p.startsWith('!') }}">{{ grantLabel(p) }}</code>
{{/each}}
{{#if r.permissions.length is 0 and not r.superAdmin}}
        <span class="acc-meta">No permissions of its own.</span>
{{/if}}
      </div>
{{#if r.superAdmin}}
      <p class="acc-meta acc-foot-note">Give it only to people who run the whole app.</p>
{{#else}}
      <div class="acc-card-foot">
        <button class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ openEditRole(r) }}">Edit</button>
        <button class="tx-btn tx-btn-ghost tx-btn-sm acc-danger" onclick="{{ askDelete('role', r.name) }}">Delete</button>
      </div>
{{/if}}
    </article>
{{/each}}
  </div>
{{#else if tab is "permissions"}}
  <div class="tx-panel acc-table">
{{#each g in permissionGroups}}
    <div class="acc-group">{{ g.name }}</div>
{{#each p in g.items}}
    <div class="acc-row">
      <div class="acc-row-main">
        <code class="acc-name">{{ p.name }}</code>
        <span class="acc-desc">{{ p.description ?? '' }}</span>
      </div>
      <div class="acc-row-side">
        <span class="acc-meta">{{ grantedBy(p.name) }}</span>
{{#if p.name is not 'roles.manage'}}
        <button class="tx-icon-btn acc-danger" aria-label="{{ 'Delete ' + p.name }}" onclick="{{ askDelete('permission', p.name) }}"><IconX class="acc-ico" /></button>
{{/if}}
      </div>
    </div>
{{/each}}
{{/each}}
{{#if permissionList.length is 0}}
    <p class="acc-empty">No permissions yet. Create one, then give it to a role.</p>
{{/if}}
  </div>
{{#else}}
  <input class="tx-input acc-search" type="search" placeholder="Search by name or email" bind:value="{{ query }}" aria-label="Search users" />
  <div class="tx-panel acc-table">
{{#each u in filteredUsers}}
    <div class="acc-row">
      <div class="acc-row-main">
        <span class="acc-user">{{ u.name }}{{ String(u.id) is me ? ' (you)' : '' }}</span>
        <span class="acc-desc">{{ u.email }}</span>
      </div>
      <div class="acc-row-side">
        <div class="acc-chips">
{{#each name in everyoneRoles}}
          <span class="acc-chip is-muted">{{ name }}</span>
{{/each}}
{{#each name in u.roles}}
          <span class="acc-chip">{{ name }}</span>
{{/each}}
        </div>
        <button class="tx-btn tx-btn-outline tx-btn-sm" onclick="{{ openUser(u) }}">Roles</button>
      </div>
    </div>
{{/each}}
{{#if filteredUsers.length is 0}}
    <p class="acc-empty">No users match “{{ query }}”.</p>
{{/if}}
  </div>
{{/if}}
</div>

{{#if modal is "role"}}
<div class="acc-overlay" role="presentation" onclick.self="{{ close() }}">
  <div class="tx-panel acc-modal acc-modal-wide" role="dialog" aria-modal="true" aria-labelledby="acc-role-title">
    <div class="acc-modal-head">
      <h3 id="acc-role-title">{{ editing ? 'Edit role ' + editing : 'New role' }}</h3>
      <button class="tx-icon-btn" aria-label="Close" onclick="{{ close() }}"><IconX class="acc-ico" /></button>
    </div>
    <div class="acc-modal-body">
      <div class="acc-two">
        <div>
          <label class="tx-label" for="acc-role-name">Name</label>
          <input id="acc-role-name" class="tx-input" autofocus bind:value="{{ roleName }}" disabled="{{ editing is not '' }}" placeholder="e.g. support" />
        </div>
        <div>
          <label class="tx-label" for="acc-role-desc">Description</label>
          <input id="acc-role-desc" class="tx-input" bind:value="{{ roleDescription }}" placeholder="What this role is for" />
        </div>
      </div>

{{#if inheritable.length > 0}}
      <p class="tx-label acc-section">Inherits <span class="acc-meta">(gets everything these roles have)</span></p>
      <div class="acc-checks">
{{#each r in inheritable}}
        <label class="acc-check"><input type="checkbox" class="tx-check" value="{{ r.name }}" bind:group="{{ roleInherits }}" /> {{ r.name }}</label>
{{/each}}
      </div>
{{/if}}

      <p class="tx-label acc-section">Permissions</p>
{{#each g in permissionGroups}}
      <div class="acc-perm-group">
        <button type="button" class="acc-group-toggle" onclick="{{ toggleGroup(g) }}">{{ g.name }}</button>
        <div class="acc-checks">
{{#each p in g.items}}
          <label class="acc-check" title="{{ p.description ?? '' }}"><input type="checkbox" class="tx-check" value="{{ p.name }}" bind:group="{{ rolePermissions }}" /> <code>{{ p.name }}</code></label>
{{/each}}
        </div>
      </div>
{{/each}}

      <p class="tx-label acc-section">Wildcards and denies <span class="acc-meta">(posts.*, *, !posts.delete)</span></p>
      <div class="acc-inline">
        <input class="tx-input" bind:value="{{ customGrant }}" placeholder="e.g. billing.* or !posts.delete" onkeydown.enter.prevent="{{ addCustomGrant() }}" />
        <button type="button" class="tx-btn tx-btn-outline tx-btn-sm" onclick="{{ addCustomGrant() }}">Add</button>
      </div>
{{#if customGrants.length > 0}}
      <div class="acc-chips acc-section">
{{#each p in customGrants}}
        <span class="acc-chip" class:is-deny="{{ p.startsWith('!') }}">{{ grantLabel(p) }} <button type="button" class="acc-chip-x" aria-label="{{ 'Remove ' + p }}" onclick="{{ removeGrant(p) }}">×</button></span>
{{/each}}
      </div>
{{/if}}

{{#if formError}}
      <p class="tx-alert tx-alert-error acc-section" role="alert">{{ formError }}</p>
{{/if}}
    </div>
    <div class="acc-modal-foot">
      <button class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ close() }}">Cancel</button>
      <button class="tx-btn tx-btn-primary tx-btn-sm" disabled="{{ saving }}" onclick="{{ saveRole() }}">{{ saving ? 'Saving…' : editing ? 'Save role' : 'Create role' }}</button>
    </div>
  </div>
</div>
{{/if}}

{{#if modal is "permission"}}
<div class="acc-overlay" role="presentation" onclick.self="{{ close() }}">
  <div class="tx-panel acc-modal" role="dialog" aria-modal="true" aria-labelledby="acc-perm-title">
    <div class="acc-modal-head">
      <h3 id="acc-perm-title">New permission</h3>
      <button class="tx-icon-btn" aria-label="Close" onclick="{{ close() }}"><IconX class="acc-ico" /></button>
    </div>
    <div class="acc-modal-body">
      <label class="tx-label" for="acc-perm-name">Name</label>
      <input id="acc-perm-name" class="tx-input" autofocus bind:value="{{ permissionName }}" placeholder="e.g. invoices.export" onkeydown.enter.prevent="{{ savePermission() }}" />
      <p class="acc-meta acc-hint">Dot-separated words: the first is the group (invoices), the rest the action (export).</p>
      <label class="tx-label acc-section" for="acc-perm-desc">Description</label>
      <input id="acc-perm-desc" class="tx-input" bind:value="{{ permissionDescription }}" placeholder="Download invoices as Excel" />
{{#if formError}}
      <p class="tx-alert tx-alert-error acc-section" role="alert">{{ formError }}</p>
{{/if}}
    </div>
    <div class="acc-modal-foot">
      <button class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ close() }}">Cancel</button>
      <button class="tx-btn tx-btn-primary tx-btn-sm" disabled="{{ saving }}" onclick="{{ savePermission() }}">{{ saving ? 'Creating…' : 'Create permission' }}</button>
    </div>
  </div>
</div>
{{/if}}

{{#if modal is "user"}}
<div class="acc-overlay" role="presentation" onclick.self="{{ close() }}">
  <div class="tx-panel acc-modal" role="dialog" aria-modal="true" aria-labelledby="acc-user-title">
    <div class="acc-modal-head">
      <h3 id="acc-user-title">Roles for {{ userName }}</h3>
      <button class="tx-icon-btn" aria-label="Close" onclick="{{ close() }}"><IconX class="acc-ico" /></button>
    </div>
    <div class="acc-modal-body">
      <div class="acc-list">
{{#each r in roles}}
{{#if not r.everyone}}
        <label class="acc-option">
          <input type="checkbox" class="tx-check" value="{{ r.name }}" bind:group="{{ userRoles }}" />
          <span><strong>{{ r.name }}</strong><span class="acc-desc">{{ r.description ?? '' }}</span></span>
        </label>
{{/if}}
{{/each}}
      </div>
{{#if everyoneRoles.length > 0}}
      <p class="acc-meta acc-hint">Everyone also has: {{ everyoneRoles.join(', ') }}.</p>
{{/if}}
{{#if formError}}
      <p class="tx-alert tx-alert-error acc-section" role="alert">{{ formError }}</p>
{{/if}}
    </div>
    <div class="acc-modal-foot">
      <button class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ close() }}">Cancel</button>
      <button class="tx-btn tx-btn-primary tx-btn-sm" disabled="{{ saving }}" onclick="{{ saveUserRoles() }}">{{ saving ? 'Saving…' : 'Save roles' }}</button>
    </div>
  </div>
</div>
{{/if}}

{{#if modal is "confirm"}}
<div class="acc-overlay" role="presentation" onclick.self="{{ close() }}">
  <div class="tx-panel acc-modal acc-modal-narrow" role="alertdialog" aria-modal="true" aria-labelledby="acc-confirm-title">
    <div class="acc-modal-body">
      <h3 id="acc-confirm-title">Delete {{ confirmKind }} {{ confirmName }}?</h3>
      <p class="acc-desc">{{ confirmKind is 'role' ? 'Everyone who has it loses what it grants.' : 'Every role and user that has it loses it.' }} This can’t be undone.</p>
{{#if formError}}
      <p class="tx-alert tx-alert-error acc-section" role="alert">{{ formError }}</p>
{{/if}}
    </div>
    <div class="acc-modal-foot">
      <button class="tx-btn tx-btn-ghost tx-btn-sm" autofocus onclick="{{ close() }}">Cancel</button>
      <button class="tx-btn tx-btn-danger tx-btn-sm" disabled="{{ saving }}" onclick="{{ confirmDelete() }}">{{ saving ? 'Deleting…' : 'Delete' }}</button>
    </div>
  </div>
</div>
{{/if}}

style
.acc { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
@media (min-width: 640px) { .acc { padding-left: 1.5rem; padding-right: 1.5rem; } }
@media (min-width: 1024px) { .acc { padding: 2.5rem 2.5rem 4rem; } }
.acc-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgb(var(--tx-line)); }
.acc-head .tx-eyebrow { margin-bottom: 0.75rem; }
.acc-head .tx-title { margin-bottom: 0.375rem; }
.acc-actions { display: flex; gap: 0.5rem; }
.acc-ico { width: 1rem; height: 1rem; }
.acc-notice { margin-bottom: 1.25rem; }
.acc-tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid rgb(var(--tx-line)); margin-bottom: 1.5rem; overflow-x: auto; }
.acc-tab { appearance: none; background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 0.625rem 0.875rem; font: inherit; font-size: 0.875rem; font-weight: 500; color: rgb(var(--tx-muted)); cursor: pointer; white-space: nowrap; }
.acc-tab:hover { color: rgb(var(--tx-ink)); }
.acc-tab.is-active { color: rgb(var(--tx-ink)); border-bottom-color: rgb(var(--tx-brand)); }
.acc-count { display: inline-block; min-width: 1.25rem; margin-left: 0.25rem; padding: 0 0.375rem; border-radius: 999px; font-size: 0.75rem; background: rgb(var(--tx-raised)); color: rgb(var(--tx-muted)); }
.acc-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
.acc-card { display: flex; flex-direction: column; gap: 0.625rem; padding: 1.25rem; }
.acc-card-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
.acc-role { margin: 0; font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
.acc-badge-brand { color: rgb(var(--tx-brand)); background: rgb(var(--tx-brand) / 0.1); }
.acc-desc { margin: 0; font-size: 0.8125rem; color: rgb(var(--tx-muted)); }
.acc-meta { font-size: 0.75rem; color: rgb(var(--tx-muted)); font-weight: 400; }
.acc-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.acc-chip { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem; border-radius: 6px; font: 0.75rem var(--tx-mono); color: rgb(var(--tx-soft)); background: rgb(var(--tx-raised)); border: 1px solid rgb(var(--tx-line)); }
.acc-chip.is-deny { color: rgb(var(--tx-coral)); background: rgb(var(--tx-coral) / 0.08); border-color: rgb(var(--tx-coral) / 0.3); }
.acc-chip.is-muted { opacity: 0.65; }
.acc-chip-x { appearance: none; border: 0; background: none; color: inherit; cursor: pointer; padding: 0 0 0 0.125rem; font-size: 0.875rem; line-height: 1; }
.acc-card-foot { display: flex; gap: 0.25rem; margin-top: auto; padding-top: 0.5rem; border-top: 1px solid rgb(var(--tx-line)); }
.acc-danger { color: rgb(var(--tx-coral)) !important; }
.acc-skeleton { height: 11rem; background: rgb(var(--tx-raised)); animation: acc-pulse 1.4s ease-in-out infinite; }
@keyframes acc-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
.acc-table { padding: 0.25rem 0; }
.acc-group { padding: 0.875rem 1.25rem 0.375rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(var(--tx-muted)); }
.acc-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1.25rem; border-top: 1px solid rgb(var(--tx-line)); }
.acc-group + .acc-row { border-top: 0; }
.acc-row-main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
.acc-row-side { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; justify-content: flex-end; }
.acc-name { font: 0.8125rem var(--tx-mono); color: rgb(var(--tx-ink)); }
.acc-user { font-size: 0.875rem; font-weight: 500; }
.acc-empty { margin: 0; padding: 2rem 1.25rem; text-align: center; font-size: 0.875rem; color: rgb(var(--tx-muted)); }
.acc-search { max-width: 22rem; margin-bottom: 1rem; }
.acc-overlay { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: rgb(var(--tx-well) / 0.6); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); animation: acc-fade 0.15s ease-out; }
.acc-modal { width: 100%; max-width: 28rem; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.35); animation: acc-rise 0.18s ease-out; }
.acc-modal-wide { max-width: 40rem; }
.acc-modal-narrow { max-width: 24rem; }
.acc-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 1.125rem 1.5rem; border-bottom: 1px solid rgb(var(--tx-line)); }
.acc-modal-head h3, .acc-modal-body h3 { margin: 0; font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
.acc-modal-body { padding: 1.25rem 1.5rem; overflow-y: auto; }
.acc-modal-body h3 { margin-bottom: 0.5rem; }
.acc-modal-foot { display: flex; justify-content: flex-end; gap: 0.5rem; padding: 1rem 1.5rem; border-top: 1px solid rgb(var(--tx-line)); }
.acc-two { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
.acc-section { margin-top: 1.25rem; }
.acc-hint { margin: 0.5rem 0 0; }
.acc-checks { display: flex; flex-wrap: wrap; gap: 0.375rem 1rem; }
.acc-check { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; cursor: pointer; }
.acc-check code { font: 0.8125rem var(--tx-mono); }
.acc-perm-group { padding: 0.75rem 0; border-top: 1px dashed rgb(var(--tx-line)); }
.acc-perm-group:first-of-type { border-top: 0; }
.acc-group-toggle { appearance: none; border: 0; background: none; padding: 0; margin-bottom: 0.5rem; font: inherit; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(var(--tx-link)); cursor: pointer; }
.acc-inline { display: flex; align-items: center; gap: 0.5rem; }
.acc-foot-note { margin: auto 0 0; padding-top: 0.75rem; border-top: 1px solid rgb(var(--tx-line)); }
.acc-list { display: flex; flex-direction: column; gap: 0.25rem; }
.acc-option { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.625rem 0.75rem; border-radius: var(--tx-radius-sm); cursor: pointer; }
.acc-option:hover { background: rgb(var(--tx-raised)); }
.acc-option > span { display: flex; flex-direction: column; gap: 0.125rem; font-size: 0.875rem; }
@keyframes acc-fade { from { opacity: 0; } }
@keyframes acc-rise { from { opacity: 0; transform: translateY(8px) scale(0.98); } }
@media (prefers-reduced-motion: reduce) { .acc-overlay, .acc-modal, .acc-skeleton { animation: none; } }
