page Status

import { IconDownload } from "tylix-icons"

title "Status"

needs
  Auth

meta
  transition "fade"

state
  checkedAuth: false
  forbidden: false
  loading: true
  error: ""
  products: []
  events: []

computed
  onlineCount() {
    return this.products.filter((p) => p.state is "online").length
  }

action
  ago(value) {
    if not value {
      return "Never"
    }
    const secs = Math.floor((Date.now() - new Date(value).getTime()) / 1000)
    if secs < 60 {
      return "Just now"
    }
    if secs < 3600 {
      return Math.floor(secs / 60) + " min ago"
    }
    if secs < 86400 {
      return Math.floor(secs / 3600) + " h ago"
    }
    return Math.floor(secs / 86400) + " d ago"
  }

  stateLabel(s) {
    if s is "online" {
      return "Online"
    }
    if s is "offline" {
      return "No heartbeat"
    }
    if s is "waiting" {
      return "Waiting for first heartbeat"
    }
    return "No API key"
  }

  stateBadge(s) {
    if s is "online" {
      return "badge-green"
    }
    if s is "offline" {
      return "badge-red"
    }
    return "badge-gray"
  }

  stateDot(s) {
    if s is "online" {
      return "bg-emerald-500"
    }
    if s is "offline" {
      return "bg-red-500"
    }
    return "bg-zinc-400"
  }

  eventBadge(type) {
    if type is "deploy.succeeded" or type is "server.recovered" or type is "product.recovered" {
      return "badge-green"
    }
    if type is "deploy.failed" or type is "server.unreachable" or type is "product.down" {
      return "badge-red"
    }
    return "badge-gray"
  }

  barClass(d) {
    if d.uptime_percent is null {
      return "bg-zinc-200 dark:bg-zinc-800"
    }
    if d.uptime_percent >= 99.9 {
      return "bg-emerald-500"
    }
    if d.uptime_percent >= 99 {
      return "bg-amber-400"
    }
    return "bg-red-500"
  }

  barTitle(d) {
    const date = new Date(d.day).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" })
    if d.uptime_percent is null {
      return date + ": no data"
    }
    if d.down_minutes > 0 {
      return date + ": " + d.uptime_percent + "% · " + d.down_minutes + " min down"
    }
    return date + ": " + d.uptime_percent + "%"
  }

  barsOf(u) {
    if not u {
      return []
    }
    return u.days.map((d) => Object.assign({}, { title: this.barTitle(d), cls: this.barClass(d) }))
  }

  uptimeText(u) {
    if not u {
      return "No uptime data yet"
    }
    if u.uptime_percent is null {
      return "No uptime data yet"
    }
    return u.uptime_percent + "% uptime"
  }

  async load() {
    this.error = ""
    const res = await useApi("/api/admin/status")

    if res.status is 403 {
      this.forbidden = true
      return null
    }
    if not res.ok {
      this.error = "Couldn't load the status."
      return null
    }

    this.products = res.data.products.map((p) => Object.assign({}, p, {
      label: this.stateLabel(p.state),
      dot: this.stateDot(p.state),
      badgeCls: this.stateBadge(p.state),
      seen: this.ago(p.last_seen_at),
      bars: this.barsOf(p.uptime),
      uptimeLabel: this.uptimeText(p.uptime),
      metricsAgo: p.metrics ? this.ago(p.metrics.reported_at) : ""
    }))
    this.events = res.data.events.map((e) => Object.assign({}, e, {
      badge: this.eventBadge(e.type),
      when: this.ago(e.occurred_at)
    }))
  }

  async refresh() {
    this.loading = true
    await this.load()
    this.loading = false
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await this.load()
    this.loading = false
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="page">

{{#if forbidden}}
    <div class="alert alert-warning max-w-2xl">
      <h1 class="alert-title">You don't have access to the Hub</h1>
      <p>Your account doesn't have a role that opens this page, or its email isn't verified yet. Ask a Hub admin for access.</p>
    </div>
{{/if}}

{{#if not forbidden}}
    <div class="page-header">
      <div>
        <h1 class="page-title">Status</h1>
        <p class="page-desc">Products report in with a heartbeat every minute. No heartbeat for 3 minutes counts as down.</p>
      </div>
      <div class="page-actions">
        <a href="/api/admin/status/export?format=pdf&days=30" title="30-day uptime report as a PDF" class="btn btn-secondary"><IconDownload /> PDF</a>
        <a href="/api/admin/status/export?format=xlsx&days=90" title="90 days of daily uptime, one sheet per product" class="btn btn-secondary"><IconDownload /> Excel</a>
        <button onclick="{{ refresh() }}" disabled="{{ loading }}" class="btn btn-secondary">{{ loading ? 'Refreshing…' : 'Refresh' }}</button>
      </div>
    </div>

{{#if error}}
    <p role="alert" class="alert alert-error mb-6">{{ error }}</p>
{{/if}}

{{#if products.length > 0}}
{{#if onlineCount is products.length}}
    <div class="card flex items-center gap-3 px-5 py-4 mb-6">
      <span class="dot bg-emerald-500"></span>
      <p class="text-sm font-medium">All products are reporting in</p>
      <p class="meta ml-auto">{{ onlineCount }} of {{ products.length }} online</p>
    </div>
{{#else}}
    <div class="card flex items-center gap-3 px-5 py-4 mb-6">
      <span class="dot bg-amber-400"></span>
      <p class="text-sm font-medium">{{ products.length - onlineCount }} of {{ products.length }} products need attention</p>
      <p class="meta ml-auto">{{ onlineCount }} online</p>
    </div>
{{/if}}
{{/if}}

{{#if products.length is 0}}
    <div class="card empty mb-8">
      <h3 class="empty-title">No products yet</h3>
      <p class="empty-text">Add a product and give it a reporting key to see its heartbeat here.</p>
    </div>
{{/if}}

    <div class="space-y-4 mb-10">
{{#each p in products}}
      <section class="card p-5">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <h2 class="font-semibold truncate">{{ p.name }}</h2>
              <span class="badge {{ p.badgeCls }}"><span class="dot w-1.5 h-1.5 {{ p.dot }}"></span>{{ p.label }}</span>
            </div>
          </div>
          <div class="flex items-center gap-4 text-right shrink-0">
            <div>
              <p class="meta">Version</p>
              <p class="font-mono text-xs font-medium mt-0.5">{{ p.last_version ? 'v' + p.last_version : '—' }}</p>
            </div>
            <div>
              <p class="meta">Last seen</p>
              <p class="text-xs font-medium mt-0.5">{{ p.seen }}</p>
            </div>
          </div>
        </div>

{{#if p.metrics}}
        <div class="{{ p.metrics.tenants ? 'grid grid-cols-2 sm:grid-cols-4' : 'grid grid-cols-2' }} gap-px mt-5 rounded-md overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-200 dark:bg-zinc-800">
{{#if p.metrics.tenants}}
          <div class="bg-zinc-50 dark:bg-zinc-950 px-4 py-3">
            <p class="meta">{{ p.metrics.tenants.label }} · total</p>
            <p class="text-xl font-semibold tabular-nums mt-0.5">{{ p.metrics.tenants.total }}</p>
          </div>
          <div class="bg-zinc-50 dark:bg-zinc-950 px-4 py-3">
            <p class="meta">{{ p.metrics.tenants.label }} · active</p>
            <p class="text-xl font-semibold tabular-nums mt-0.5">{{ p.metrics.tenants.active }}</p>
          </div>
{{/if}}
          <div class="bg-zinc-50 dark:bg-zinc-950 px-4 py-3">
            <p class="meta">Users · total</p>
            <p class="text-xl font-semibold tabular-nums mt-0.5">{{ p.metrics.users_total }}</p>
          </div>
          <div class="bg-zinc-50 dark:bg-zinc-950 px-4 py-3">
            <p class="meta">Users · active</p>
            <p class="text-xl font-semibold tabular-nums mt-0.5">{{ p.metrics.users_active }}</p>
          </div>
        </div>
        <p class="meta mt-2">Active means signed in during the last {{ p.metrics.active_days }} days. Updated {{ p.metricsAgo }}.</p>
{{/if}}

{{#if p.bars.length > 0}}
        <div class="mt-5">
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-medium text-zinc-700 dark:text-zinc-300">Uptime · last 90 days</p>
            <p class="text-xs font-medium tabular-nums">{{ p.uptimeLabel }}</p>
          </div>
          <div class="flex gap-[2px] h-8" role="img" aria-label="Daily uptime for the last 90 days">
{{#each b in p.bars}}
            <span title="{{ b.title }}" class="flex-1 rounded-sm {{ b.cls }}"></span>
{{/each}}
          </div>
          <div class="flex items-center justify-between meta mt-1.5">
            <span>90 days ago</span>
            <span>Today</span>
          </div>
        </div>
{{/if}}
      </section>
{{/each}}
    </div>

    <div class="section-head">
      <h2 class="section-title">Recent events</h2>
    </div>
    <section class="card overflow-hidden">
{{#if events.length is 0}}
      <p class="px-5 py-10 text-center text-sm text-zinc-500">No events reported yet.</p>
{{/if}}

{{#each e in events}}
      <div class="row-divider flex items-center gap-4 px-5 py-3">
        <span class="badge font-mono shrink-0 {{ e.badge }}">{{ e.type }}</span>
        <p class="text-sm min-w-0 flex-1 truncate"><span class="font-medium">{{ e.productName }}</span>{{ e.message ? ' · ' + e.message : '' }}</p>
        <span class="meta shrink-0">{{ e.when }}</span>
      </div>
{{/each}}
    </section>
{{/if}}

  </div>
{{/if}}

{{#if not checkedAuth}}
  <p class="page-loading">Loading…</p>
{{/if}}
