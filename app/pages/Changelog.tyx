page Changelog

import { IconDownload } from "tylix-icons"

title "Changelog"

needs
  Auth

meta
  transition "fade"

state
  checkedAuth: false
  forbidden: false
  loading: true
  listError: ""
  products: []
  entries: []
  statusTabs: []
  categories: ["added", "improved", "fixed", "security", "breaking"]
  statuses: ["draft", "scheduled", "published"]
  filterProduct: 0
  filterState: "all"
  chipOn: "chip chip-on"
  chipOff: "chip chip-off"
  editorOpen: false
  editingId: 0
  fProduct: 0
  fVersion: ""
  fTitle: ""
  fCategory: "added"
  fStatus: "draft"
  fDate: ""
  fBody: ""
  errors: {}
  formError: ""
  saving: false

computed
  visible() {
    return this.entries.filter((e) => (this.filterProduct is 0 or e.product_id is this.filterProduct) and (this.filterState is "all" or e.state is this.filterState))
  }

action
  setField(field, value) {
    this[field] = value
  }

  // Downloads follow the product filter.
  exportUrl(format) {
    return "/api/admin/changelog/export?format=" + format + (this.filterProduct ? "&product_id=" + this.filterProduct : "")
  }

  setFilter(field, value) {
    this[field] = value
  }

  errorsOf(raw) {
    return Object.fromEntries(Object.keys(raw).map((k) => [k, raw[k][0]]))
  }

  stateOf(e) {
    if e.status is "draft" {
      return "draft"
    }
    const at = new Date(e.published_at).getTime()
    if e.status is "scheduled" and at > Date.now() {
      return "scheduled"
    }
    return "live"
  }

  stateLabel(s) {
    if s is "live" {
      return "Published"
    }
    if s is "scheduled" {
      return "Scheduled"
    }
    return "Draft"
  }

  stateBadge(s) {
    if s is "live" {
      return "badge-green"
    }
    if s is "scheduled" {
      return "badge-amber"
    }
    return "badge-gray"
  }

  categoryBadge(category) {
    const map = [
      ["added", "badge-violet"],
      ["improved", "badge-blue"],
      ["fixed", "badge-teal"],
      ["security", "badge-amber"],
      ["breaking", "badge-red"]
    ]
    const hit = map.find((m) => m[0] is category)
    return hit ? hit[1] : "badge-gray"
  }

  whenText(value) {
    if not value {
      return "Not published"
    }
    const d = new Date(value)
    const day = d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
    const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
    return day + ", " + time
  }

  // The value a datetime-local input expects, in the browser's own timezone.
  toLocalInput(iso) {
    if not iso {
      return ""
    }
    const d = new Date(iso)
    const pad = (n) => (n < 10 ? "0" + n : "" + n)
    return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes())
  }

  decorate(e, prods) {
    const owner = prods.find((p) => p.id is e.product_id)
    const s = this.stateOf(e)
    return Object.assign({}, e, {
      productName: owner ? owner.name : "Unknown product",
      state: s,
      stateText: this.stateLabel(s),
      stateClass: this.stateBadge(s),
      badge: this.categoryBadge(e.category),
      whenLabel: this.whenText(e.published_at),
      preview: String(e.body).replace(/\n/g, " ").slice(0, 140)
    })
  }

  resetForm() {
    this.fProduct = this.filterProduct is 0 ? (this.products.length > 0 ? this.products[0].id : 0) : this.filterProduct
    this.fVersion = ""
    this.fTitle = ""
    this.fCategory = "added"
    this.fStatus = "draft"
    this.fDate = ""
    this.fBody = ""
    this.errors = {}
    this.formError = ""
  }

  openNew() {
    this.resetForm()
    this.editingId = 0
    this.editorOpen = true
  }

  openEdit(e) {
    this.resetForm()
    this.editingId = e.id
    this.fProduct = e.product_id
    this.fVersion = e.version
    this.fTitle = e.title
    this.fCategory = e.category
    this.fStatus = e.status
    this.fDate = this.toLocalInput(e.published_at)
    this.fBody = e.body
    this.editorOpen = true
  }

  closeEditor() {
    this.editorOpen = false
    this.editingId = 0
    this.resetForm()
  }

  async load() {
    const results = await Promise.all([
      useApi("/api/admin/products"),
      useApi("/api/admin/changelog")
    ])
    const productRes = results[0]
    const entryRes = results[1]

    if productRes.status is 403 or entryRes.status is 403 {
      this.forbidden = true
      return null
    }
    if not productRes.ok or not entryRes.ok {
      this.listError = "Couldn't load the changelog."
      return null
    }

    this.products = productRes.data
    this.entries = entryRes.data.map((e) => this.decorate(e, productRes.data))
    this.listError = ""
  }

  async save() {
    if this.saving {
      return null
    }

    this.saving = true
    this.errors = {}
    this.formError = ""

    const isNew = this.editingId is 0
    const when = this.fStatus is "draft" or not this.fDate ? "" : new Date(this.fDate).toISOString()
    const body = {
      product_id: this.fProduct,
      version: this.fVersion,
      title: this.fTitle,
      body: this.fBody,
      category: this.fCategory,
      status: this.fStatus,
      published_at: when
    }
    const path = isNew ? "/api/admin/changelog" : "/api/admin/changelog/" + this.editingId
    const result = await useApi(path, { method: isNew ? "POST" : "PUT", body: body })

    this.saving = false

    if result.ok {
      this.closeEditor()
      await this.load()
      return null
    }

    const raw = result.data?.errors
    if raw {
      this.errors = this.errorsOf(raw)
    } else {
      this.formError = result.data?.error ?? result.error ?? "Could not save the entry."
    }
  }

  async remove(e) {
    if not confirm("Delete " + e.productName + " v" + e.version + "?") {
      return null
    }

    this.listError = ""
    const result = await useApi("/api/admin/changelog/" + e.id, { method: "DELETE" })

    if result.ok {
      if this.editingId is e.id {
        this.closeEditor()
      }
      await this.load()
    } else {
      this.listError = result.data?.error ?? result.error ?? "Could not delete the entry."
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    this.statusTabs = [
      { key: "all", label: "All" },
      { key: "live", label: "Published" },
      { key: "scheduled", label: "Scheduled" },
      { key: "draft", label: "Drafts" }
    ]

    await this.load()
    this.loading = false
    this.checkedAuth = true

    if window.location.search.includes("new=1") and this.can("changelog.manage") {
      this.openNew()
    }
  }

template
{{#if checkedAuth}}
  <div class="page">

{{#if forbidden}}
    <div class="alert alert-warning max-w-2xl">
      <h1 class="alert-title">You don't have access to the Hub</h1>
      <p>Your account doesn't have a role that opens this page, or its email isn't verified yet. Ask a Hub admin for access.</p>
    </div>
{{/if}}

{{#if not forbidden}}
    <div class="page-header">
      <div>
        <h1 class="page-title">Changelog</h1>
        <p class="page-desc">Write once, publish to every connected site.</p>
      </div>
      <div class="page-actions">
        <a href="{{ exportUrl('pdf') }}" title="Release notes as a PDF document" class="btn btn-secondary"><IconDownload class="w-4 h-4" /> PDF</a>
        <a href="{{ exportUrl('xlsx') }}" title="Every release as an Excel sheet" class="btn btn-secondary"><IconDownload class="w-4 h-4" /> Excel</a>
{{#if can("changelog.manage")}}
        <button onclick="{{ openNew() }}" class="btn btn-primary">New release</button>
{{/if}}
      </div>
    </div>

{{#if listError}}
    <p role="alert" class="alert alert-error mb-6">{{ listError }}</p>
{{/if}}

{{#if editorOpen}}
    <section class="card p-5 sm:p-6 mb-8">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm font-semibold">{{ editingId is 0 ? 'New release' : 'Edit release' }}</h2>
        <button onclick="{{ closeEditor() }}" class="text-sm text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors">Close</button>
      </div>

{{#if formError}}
      <p role="alert" class="alert alert-error mb-4">{{ formError }}</p>
{{/if}}

{{#if products.length is 0}}
      <p class="text-sm text-zinc-500 mb-2">Add a product first, then write its releases.</p>
      <a href="/products?new=1" class="text-sm link">Add a product</a>
{{/if}}

{{#if products.length > 0}}
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div>
          <label for="c-product" class="label">Product</label>
          <select id="c-product" disabled="{{ editingId is not 0 }}" onchange="{{ setField('fProduct', Number(event.target.value)) }}" class="input">
{{#each p in products}}
            <option value="{{ p.id }}" selected="{{ fProduct is p.id }}">{{ p.name }}</option>
{{/each}}
          </select>
{{#if errors.product_id}}
          <p class="field-error">{{ errors.product_id }}</p>
{{/if}}
        </div>

        <div>
          <label for="c-version" class="label">Version</label>
          <input id="c-version" type="text" placeholder="0.2.0" value="{{ fVersion }}" oninput="{{ setField('fVersion', event.target.value) }}" class="input font-mono" />
{{#if errors.version}}
          <p class="field-error">{{ errors.version }}</p>
{{/if}}
        </div>

        <div>
          <label for="c-category" class="label">Category</label>
          <select id="c-category" onchange="{{ setField('fCategory', event.target.value) }}" class="input capitalize">
{{#each c in categories}}
            <option value="{{ c }}" selected="{{ fCategory is c }}">{{ c }}</option>
{{/each}}
          </select>
{{#if errors.category}}
          <p class="field-error">{{ errors.category }}</p>
{{/if}}
        </div>

        <div>
          <label for="c-status" class="label">Status</label>
          <select id="c-status" onchange="{{ setField('fStatus', event.target.value) }}" class="input capitalize">
{{#each s in statuses}}
            <option value="{{ s }}" selected="{{ fStatus is s }}">{{ s }}</option>
{{/each}}
          </select>
{{#if errors.status}}
          <p class="field-error">{{ errors.status }}</p>
{{/if}}
        </div>
      </div>

{{#if fStatus is not "draft"}}
      <div class="mt-4 max-w-xs">
        <label for="c-date" class="label">{{ fStatus is 'scheduled' ? 'Goes live at' : 'Published at (optional)' }}</label>
        <input id="c-date" type="datetime-local" value="{{ fDate }}" oninput="{{ setField('fDate', event.target.value) }}" class="input" />
{{#if errors.published_at}}
        <p class="field-error">{{ errors.published_at }}</p>
{{/if}}
      </div>
{{/if}}

      <label for="c-title" class="label mt-4">Title</label>
      <input id="c-title" type="text" placeholder="Docker sites, one-click deploys" value="{{ fTitle }}" oninput="{{ setField('fTitle', event.target.value) }}" class="input" />
{{#if errors.title}}
      <p class="field-error">{{ errors.title }}</p>
{{/if}}

      <label for="c-body" class="label mt-4">What changed (Markdown)</label>
      <textarea id="c-body" rows="9" placeholder="- Added a Docker site type&#10;- Fixed the server logs page" value="{{ fBody }}" oninput="{{ setField('fBody', event.target.value) }}" class="input font-mono"></textarea>
{{#if errors.body}}
      <p class="field-error">{{ errors.body }}</p>
{{/if}}

      <div class="flex items-center gap-2 mt-5">
        <button onclick="{{ save() }}" disabled="{{ saving }}" class="btn btn-primary">
          {{ saving ? 'Saving…' : 'Save release' }}
        </button>
        <button onclick="{{ closeEditor() }}" class="btn btn-ghost">Cancel</button>
      </div>
{{/if}}
    </section>
{{/if}}

    <div class="card flex flex-col gap-3 px-4 py-3 mb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="filter-label w-16">Product</span>
        <button onclick="{{ setFilter('filterProduct', 0) }}" class="{{ filterProduct is 0 ? chipOn : chipOff }}">All products</button>
{{#each p in products}}
        <button onclick="{{ setFilter('filterProduct', p.id) }}" class="{{ filterProduct is p.id ? chipOn : chipOff }}">{{ p.name }}</button>
{{/each}}
      </div>
      <div class="flex flex-wrap items-center gap-2 border-t border-zinc-100 dark:border-zinc-800 pt-3">
        <span class="filter-label w-16">Status</span>
{{#each t in statusTabs}}
        <button onclick="{{ setFilter('filterState', t.key) }}" class="{{ filterState is t.key ? chipOn : chipOff }}">{{ t.label }}</button>
{{/each}}
      </div>
    </div>

    <section class="card overflow-hidden">
{{#if loading}}
      <p class="px-5 py-10 text-center text-sm text-zinc-500">Loading…</p>
{{/if}}

{{#if not loading}}
{{#if visible.length is 0}}
      <div class="empty">
        <h3 class="empty-title">Nothing here</h3>
        <p class="empty-text">No releases match these filters.</p>
      </div>
{{/if}}
{{/if}}

{{#each e in visible}}
      <div class="flex items-start gap-4 px-5 py-4 row-divider row-hover">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1">
            <span class="text-[13px] text-zinc-500 dark:text-zinc-400">{{ e.productName }}</span>
            <span class="mono-meta">v{{ e.version }}</span>
            <span class="badge {{ e.badge }}">{{ e.category }}</span>
            <span class="badge {{ e.stateClass }}">{{ e.stateText }}</span>
          </div>
          <p class="text-[15px] font-medium text-zinc-900 dark:text-zinc-100">{{ e.title }}</p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 truncate">{{ e.preview }}</p>
          <p class="meta mt-2">{{ e.whenLabel }}</p>
        </div>
        <div class="flex items-center gap-1 shrink-0">
{{#if can("changelog.manage")}}
          <button onclick="{{ openEdit(e) }}" class="btn btn-ghost btn-sm">Edit</button>
          <button onclick="{{ remove(e) }}" class="btn btn-danger-ghost btn-sm">Delete</button>
{{/if}}
        </div>
      </div>
{{/each}}
    </section>
{{/if}}

  </div>
{{/if}}

{{#if not checkedAuth}}
  <p class="page-loading">Loading…</p>
{{/if}}