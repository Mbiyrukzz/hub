page Login

title "Sign in"

needs
  Auth

state
  email: ""
  password: ""
  error: ""
  submitting: false

action
  setField(field, value) {
    this[field] = value
  }

  validate() {
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      return "Enter a valid email address."
    }
    if this.password.length is 0 {
      return "Enter your password."
    }
    return ""
  }

  messageFor(result) {
    switch result.status {
      case 401, 403 {
        return result.data?.error ?? "Invalid email or password."
      }
      case 422 {
        const errors = result.data?.errors
        if errors {
          const firstField = Object.keys(errors)[0]
          return errors[firstField][0]
        }
        return "Check your details and try again."
      }
      case 429 {
        return "Too many attempts. Wait a minute and try again."
      }
      default {
        return result.error ?? "Could not sign in. Try again."
      }
    }
  }

  async submit() {
    if this.submitting {
      return null
    }

    this.error = this.validate()
    if this.error {
      return null
    }

    this.submitting = true
    let succeeded = false

    try {
      const result = await Auth.login(this.email, this.password)

      if result.ok {
        succeeded = true
        window.location.href = "/dashboard"
      } else {
        this.error = this.messageFor(result)
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      if not succeeded {
        this.submitting = false
      }
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = "/dashboard"
    }
  }

template
  <div class="flex items-center justify-center px-6 py-24">
    <div class="w-full max-w-sm">

      <div class="flex items-center gap-2.5 mb-8">
        <span class="w-8 h-8 rounded-md bg-indigo-500 flex items-center justify-center text-white font-bold text-sm">A</span>
        <span class="font-semibold tracking-tight">Ashmif Hub</span>
      </div>

      <h1 class="text-2xl font-semibold tracking-tight mb-1">Sign in</h1>
      <p class="text-sm text-slate-500 mb-8">Internal release and status console.</p>

{{#if error}}
      <div role="alert" aria-live="polite" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
        <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
      </div>
{{/if}}

      <label for="email" class="block text-slate-500 text-xs font-medium mb-1.5">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        autofocus
        placeholder="you@ashmif.com"
        value="{{ email }}"
        oninput="{{ setField('email', event.target.value) }}"
        onkeydown="{{ event.key is 'Enter' and submit() }}"
        class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition"
      />

      <label for="password" class="block text-slate-500 text-xs font-medium mb-1.5">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        placeholder="••••••••"
        value="{{ password }}"
        oninput="{{ setField('password', event.target.value) }}"
        onkeydown="{{ event.key is 'Enter' and submit() }}"
        class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 rounded-md px-3.5 py-2.5 mb-2 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition"
      />

      <div class="flex justify-end mb-6">
        <a href="/forgot-password" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">Forgot password?</a>
      </div>

      <button
        onclick="{{ submit() }}"
        disabled="{{ submitting }}"
        class="w-full bg-indigo-600 text-white rounded-md py-2.5 text-sm font-medium hover:bg-indigo-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {{ submitting ? 'Signing in…' : 'Sign in' }}
      </button>

    </div>
  </div>