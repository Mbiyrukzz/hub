page Products

title "Products"

needs
  Auth

meta
  transition "fade"

state
  checkedAuth: false
  forbidden: false
  loading: true
  listError: ""
  products: []
  editorOpen: false
  editingId: 0
  fName: ""
  fSlug: ""
  fUrl: ""
  fDesc: ""
  fActive: true
  errors: {}
  formError: ""
  saving: false
  newKey: ""
  keyBusy: false
  keyError: ""
  keyCopied: false

action
  setField(field, value) {
    this[field] = value
  }

  toggleActive() {
    this.fActive = not this.fActive
  }

  errorsOf(raw) {
    return Object.fromEntries(Object.keys(raw).map((k) => [k, raw[k][0]]))
  }

  resetForm() {
    this.fName = ""
    this.fSlug = ""
    this.fUrl = ""
    this.fDesc = ""
    this.fActive = true
    this.errors = {}
    this.formError = ""
    this.newKey = ""
    this.keyError = ""
    this.keyCopied = false
  }

  openNew() {
    this.resetForm()
    this.editingId = 0
    this.editorOpen = true
  }

  openEdit(p) {
    this.resetForm()
    this.editingId = p.id
    this.fName = p.name
    this.fSlug = p.slug
    this.fUrl = p.website_url ?? ""
    this.fDesc = p.description ?? ""
    this.fActive = p.is_active
    this.editorOpen = true
  }

  closeEditor() {
    this.editorOpen = false
    this.editingId = 0
    this.resetForm()
  }

  decorate(p, entries) {
    return Object.assign({}, p, {
      entryCount: entries.filter((e) => e.product_id is p.id).length
    })
  }

  async load() {
    const results = await Promise.all([
      useApi("/api/admin/products"),
      useApi("/api/admin/changelog")
    ])
    const productRes = results[0]
    const entryRes = results[1]

    if productRes.status is 403 {
      this.forbidden = true
      return null
    }
    if not productRes.ok {
      this.listError = "Couldn't load products."
      return null
    }

    const entries = entryRes.ok and Array.isArray(entryRes.data) ? entryRes.data : []
    this.products = productRes.data.map((p) => this.decorate(p, entries))
    this.listError = ""
  }

  async save() {
    if this.saving {
      return null
    }

    this.saving = true
    this.errors = {}
    this.formError = ""

    const isNew = this.editingId is 0
    const body = {
      name: this.fName,
      slug: this.fSlug,
      website_url: this.fUrl,
      description: this.fDesc,
      is_active: this.fActive
    }
    const path = isNew ? "/api/admin/products" : "/api/admin/products/" + this.editingId
    const result = await useApi(path, { method: isNew ? "POST" : "PUT", body: body })

    this.saving = false

    if result.ok {
      this.closeEditor()
      await this.load()
      return null
    }

    const raw = result.data?.errors
    if raw {
      this.errors = this.errorsOf(raw)
    } else {
      this.formError = result.data?.error ?? result.error ?? "Could not save the product."
    }
  }

  async remove(p) {
    if not confirm("Delete " + p.name + "?") {
      return null
    }

    this.listError = ""
    const result = await useApi("/api/admin/products/" + p.id, { method: "DELETE" })

    if result.ok {
      if this.editingId is p.id {
        this.closeEditor()
      }
      await this.load()
    } else {
      this.listError = result.data?.error ?? result.error ?? "Could not delete the product."
    }
  }

  async generateKey() {
    if this.editingId is 0 or this.keyBusy {
      return null
    }
    if not confirm("Generate a new API key? A key already in use will stop working.") {
      return null
    }

    this.keyBusy = true
    this.keyError = ""
    this.newKey = ""
    this.keyCopied = false

    const result = await useApi("/api/admin/products/" + this.editingId + "/key", { method: "POST", body: {} })

    this.keyBusy = false

    if result.ok {
      this.newKey = result.data.key
    } else {
      this.keyError = result.data?.error ?? result.error ?? "Could not generate a key."
    }
  }

  clearKeyCopied() {
    this.keyCopied = false
  }

  async copyKey() {
    try {
      await navigator.clipboard.writeText(this.newKey)
      this.keyCopied = true
      setTimeout(() => this.clearKeyCopied(), 1500)
    } catch (err) {
      this.keyCopied = false
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await this.load()
    this.loading = false
    this.checkedAuth = true

    if window.location.search.includes("new=1") and this.can("products.manage") {
      this.openNew()
    }
  }

template
{{#if checkedAuth}}
  <div class="page">

{{#if forbidden}}
    <div class="alert alert-warning max-w-2xl">
      <h1 class="alert-title">You don't have access to the Hub</h1>
      <p>Your account doesn't have a role that opens this page, or its email isn't verified yet. Ask a Hub admin for access.</p>
    </div>
{{/if}}

{{#if not forbidden}}
    <div class="page-header">
      <div>
        <h1 class="page-title">Products</h1>
        <p class="page-desc">Every site that reads from the Hub is a product here.</p>
      </div>
{{#if can("products.manage")}}
      <button onclick="{{ openNew() }}" class="btn btn-primary">Add product</button>
{{/if}}
    </div>

{{#if listError}}
    <p role="alert" class="alert alert-error mb-6">{{ listError }}</p>
{{/if}}

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_380px] gap-6 items-start">

      <section class="card overflow-hidden">
{{#if loading}}
        <p class="px-5 py-10 text-center text-sm text-zinc-500">Loading…</p>
{{/if}}

{{#if not loading}}
{{#if products.length is 0}}
        <div class="empty">
          <h3 class="empty-title">No products yet</h3>
          <p class="empty-text">Add Tylix Deploy first, then the Tylix framework.</p>
        </div>
{{/if}}
{{/if}}

{{#each p in products}}
        <div class="flex items-center gap-4 px-5 py-4 row-divider">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p class="font-medium truncate">{{ p.name }}</p>
{{#if p.is_active}}
              <span class="badge badge-green">Active</span>
{{/if}}
{{#if not p.is_active}}
              <span class="badge badge-gray">Hidden</span>
{{/if}}
            </div>
            <p class="font-mono text-xs text-zinc-500 truncate mt-0.5">{{ p.slug }}{{ p.website_url ? ' · ' + p.website_url : '' }}</p>
          </div>
          <span class="hidden sm:inline text-xs text-zinc-500 shrink-0">{{ p.entryCount is 1 ? '1 entry' : p.entryCount + ' entries' }}</span>
          <div class="flex items-center gap-1 shrink-0">
{{#if can("products.manage")}}
            <button onclick="{{ openEdit(p) }}" class="btn btn-ghost btn-sm">Edit</button>
            <button onclick="{{ remove(p) }}" class="btn btn-danger-ghost btn-sm">Delete</button>
{{/if}}
          </div>
        </div>
{{/each}}
      </section>

      <aside class="lg:sticky lg:top-6">
{{#if not editorOpen}}
        <div class="card-dashed p-6">
{{#if can("products.manage")}}
          <h2 class="text-sm font-semibold mb-1">Product editor</h2>
          <p class="text-sm text-zinc-500">Pick a product to edit, or add a new one.</p>
{{#else}}
          <h2 class="text-sm font-semibold mb-1">Read-only</h2>
          <p class="text-sm text-zinc-500">Your role can see products but not change them. Ask a Hub admin if you need to.</p>
{{/if}}
        </div>
{{/if}}

{{#if editorOpen}}
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-semibold">{{ editingId is 0 ? 'New product' : 'Edit product' }}</h2>
            <button onclick="{{ closeEditor() }}" class="text-sm text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors">Close</button>
          </div>

{{#if formError}}
          <p role="alert" class="alert alert-error mb-4">{{ formError }}</p>
{{/if}}

          <label for="p-name" class="label">Name</label>
          <input id="p-name" type="text" placeholder="Tylix Deploy" value="{{ fName }}" oninput="{{ setField('fName', event.target.value) }}" class="input" />
{{#if errors.name}}
          <p class="field-error">{{ errors.name }}</p>
{{/if}}

          <label for="p-slug" class="label mt-4">Slug</label>
          <input id="p-slug" type="text" placeholder="tylix-deploy" disabled="{{ editingId is not 0 }}" value="{{ fSlug }}" oninput="{{ setField('fSlug', event.target.value) }}" class="input font-mono" />
          <p class="hint">Part of the public API address. It can't be changed later.</p>
{{#if errors.slug}}
          <p class="field-error">{{ errors.slug }}</p>
{{/if}}

          <label for="p-url" class="label mt-4">Website</label>
          <input id="p-url" type="text" placeholder="https://deploy.ashmif.com" value="{{ fUrl }}" oninput="{{ setField('fUrl', event.target.value) }}" class="input" />
{{#if errors.website_url}}
          <p class="field-error">{{ errors.website_url }}</p>
{{/if}}

          <label for="p-desc" class="label mt-4">Description</label>
          <textarea id="p-desc" rows="3" value="{{ fDesc }}" oninput="{{ setField('fDesc', event.target.value) }}" class="input"></textarea>
{{#if errors.description}}
          <p class="field-error">{{ errors.description }}</p>
{{/if}}

          <label class="flex items-center gap-2 mt-4 text-sm text-zinc-600 dark:text-zinc-300">
            <input type="checkbox" checked="{{ fActive }}" onclick="{{ toggleActive() }}" class="rounded border-zinc-300 dark:border-zinc-700 text-brand-600 focus:ring-brand-500" />
            Visible in the public API
          </label>

{{#if editingId is not 0}}
          <div class="mt-5 rounded-md border border-zinc-200 dark:border-zinc-800 p-3">
            <p class="text-xs font-medium text-zinc-500 mb-2">API key for reporting status</p>
{{#if keyError}}
            <p role="alert" class="text-xs text-red-600 dark:text-red-400 mb-2">{{ keyError }}</p>
{{/if}}
{{#if newKey}}
            <button onclick="{{ copyKey() }}" title="Copy the key" class="w-full text-left code-chip text-zinc-700 dark:text-zinc-300 break-all hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors">{{ keyCopied ? 'Copied to clipboard' : newKey }}</button>
            <p class="text-xs text-amber-600 dark:text-amber-400 mt-2">Copy it now. It is shown once and can't be retrieved later.</p>
{{/if}}
{{#if can("products.keys")}}
            <button onclick="{{ generateKey() }}" disabled="{{ keyBusy }}" class="btn btn-secondary btn-sm mt-2">{{ keyBusy ? 'Generating…' : 'Generate new key' }}</button>
{{#else}}
            <p class="mt-2 text-xs text-zinc-500">Only admins can issue reporting keys.</p>
{{/if}}
          </div>
{{/if}}

          <button onclick="{{ save() }}" disabled="{{ saving }}" class="btn btn-primary mt-5 w-full">
            {{ saving ? 'Saving…' : 'Save product' }}
          </button>
        </div>
{{/if}}
      </aside>
    </div>
{{/if}}

  </div>
{{/if}}

{{#if not checkedAuth}}
  <p class="page-loading">Loading…</p>
{{/if}}