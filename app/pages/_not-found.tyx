page NotFound

title "Page not found"

template
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6">
    <p class="font-mono text-sm font-medium text-zinc-500">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400 max-w-sm">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-6 flex items-center gap-2">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/status" class="btn btn-secondary">View status</a>
    </div>
  </div>
