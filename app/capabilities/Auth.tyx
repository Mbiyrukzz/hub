capability Auth

state
  user: null
  loading: true

action
  // With two-factor on, a right password answers { twoFactorRequired: true }
  // and nobody is signed in until verifyTwoFactor() gets a good code.
  async login(email, password, remember = true) {
    const result = await useApi("/api/login", { method: "POST", body: { email, password, remember } })
    if result.ok and not result.data?.twoFactorRequired {
      this.user = result.data?.user ?? result.data
    }
    return result
  }

  async verifyTwoFactor(code) {
    const result = await useApi("/api/auth/two-factor", { method: "POST", body: { code } })
    if result.ok {
      this.user = result.data.user
    }
    return result
  }

  async logout() {
    await useApi("/api/auth/logout", { method: "POST" })
    this.user = null
    window.location.href = "/"
  }

init
  async {
    const me = await useApi("/api/me")
    if me.ok {
      this.user = me.data
    }
    this.loading = false
  }