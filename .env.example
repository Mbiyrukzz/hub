# The docs site reads the Hub at HUB_URL=http://localhost:3001.
PORT=3001
APP_URL=http://localhost:3001

# 32+ random characters, required in production: openssl rand -base64 48
AUTH_SECRET=

# Shows real error details (SQL, stack traces, request data) in the browser
# and API responses. Keep false in production: it leaks internals.
APP_DEBUG=false

DATABASE_DRIVER=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=hub

# Bootstrap admins (comma separated). "tylix db:seed" gives each listed,
# verified account the admin role; after that, manage people in
# /admin/access or with "tylix permission:assign <role> <email>".
# Listed accounts also keep receiving downtime alerts.
HUB_ADMINS=

# Sign-ups (form and Google/GitHub) are closed unless this is true.
ALLOW_REGISTRATION=false

# Two-factor sign-in: the name authenticator apps show next to the code.
TWO_FACTOR_ISSUER="Ashmif Hub"

# Audit log (/admin/audit): entries older than this many days are removed
# by the daily task in app/schedule.ts (run "tylix schedule:work").
AUDIT_RETENTION_DAYS=365

# Optional social sign-in for existing accounts.
# callback: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# callback: <APP_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MAIL_DRIVER=log
MAIL_FROM=noreply@hub.test
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# Set to true only when this app runs behind a reverse proxy you control
# (nginx, Caddy, a load balancer). Leave false otherwise, because clients
# could fake their IP address through the X-Forwarded-For header.
TRUST_PROXY=false

# Largest request body the server accepts, in bytes (1048576 = 1 MB).
# Bigger requests get a 413 response. Raise it if your app accepts uploads.
MAX_BODY_BYTES=1048576

# Logs: console plus daily files in storage/logs, kept 14 days.
# LOG_STACK=console turns the files off (containers, read-only disks).
LOG_CHANNEL=stack
LOG_STACK=console,daily
LOG_DAILY_DAYS=14

# Set to true only if you're developing @tylix/compiler itself
TYLIX_HOT_RELOAD_COMPILER=false
